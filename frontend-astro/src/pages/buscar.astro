---
import BaseLayout from '../layouts/BaseLayout.astro';
import catalogo from '../data/catalogo.json';

// Get unique law codes for filter chips
const leyes = catalogo.leyes.map(l => ({ codigo: l.codigo, nombre: l.nombre }));

// Document types
const tiposDocumento = [
  { value: 'ley', label: 'Leyes', color: 'bg-primary-600' },
  { value: 'codigo', label: 'Códigos', color: 'bg-primary-600' },
  { value: 'reglamento', label: 'Reglamentos', color: 'bg-blue-600' },
  { value: 'resolucion', label: 'RMF', color: 'bg-amber-600' },
];

// Categories (colors match index.astro)
const categorias = [
  { value: 'fiscal', label: 'Fiscal', color: 'bg-emerald-600' },
  { value: 'laboral', label: 'Laboral', color: 'bg-blue-600' },
  { value: 'constitucional', label: 'Constitucional', color: 'bg-orange-600' },
];
---

<BaseLayout title="Buscar - LeyesMX" description="Busca artículos en leyes fiscales y laborales de México">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-20 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="container mx-auto max-w-4xl flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold">
          <svg class="w-6 h-6" viewBox="0 0 32 32" fill="currentColor">
            <rect width="32" height="32" rx="6" fill="currentColor"/>
            <text x="16" y="22" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="white">LM</text>
          </svg>
          <span>LeyesMX</span>
        </a>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 container mx-auto max-w-4xl px-4 py-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Buscar</h1>

      <!-- Search form -->
      <form id="search-form" class="relative">
        <div class="relative">
          <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="search-input"
            type="text"
            name="q"
            placeholder="Buscar en leyes fiscales y laborales..."
            class="w-full rounded-xl border-2 border-gray-200 bg-white py-4 pl-12 pr-24 text-lg placeholder-gray-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-4 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500"
            autocomplete="off"
            autofocus
          />
          <div class="absolute right-3 top-1/2 flex -translate-y-1/2 items-center gap-2">
            <button
              id="clear-btn"
              type="button"
              class="hidden rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <button type="submit" class="btn-primary px-4 py-2">
              Buscar
            </button>
          </div>
        </div>

        <!-- Filters toggle -->
        <div class="mt-2 flex items-center gap-2 text-sm text-gray-500">
          <button
            id="filters-toggle"
            type="button"
            class="flex items-center gap-1 rounded-lg px-2 py-1 hover:bg-gray-100 dark:hover:bg-gray-800"
          >
            Filtros
            <span id="filter-count" class="hidden ml-1 rounded-full bg-primary-100 px-2 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900 dark:text-primary-300">0</span>
          </button>
          <span class="text-gray-400">
            Presiona <kbd class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs dark:bg-gray-700">/</kbd> para buscar
          </span>
        </div>
      </form>

      <!-- Filters panel -->
      <div id="filters-panel" class="hidden mt-2 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-700 dark:bg-gray-800 space-y-3">
        <!-- Filter by category -->
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-2">Categoría</label>
          <div class="flex flex-wrap gap-2">
            {categorias.map((cat) => (
              <button
                type="button"
                data-filter-categoria={cat.value}
                data-color={cat.color}
                class="filter-chip rounded-full px-3 py-1 text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600"
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Filter by document type -->
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-2">Tipo de documento</label>
          <div class="flex flex-wrap gap-2">
            {tiposDocumento.map((tipo) => (
              <button
                type="button"
                data-filter-tipo={tipo.value}
                data-color={tipo.color}
                class="filter-chip rounded-full px-3 py-1 text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600"
              >
                {tipo.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Filter by specific law -->
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-2">Ley específica</label>
          <div class="flex flex-wrap gap-2">
            {leyes.map((ley) => (
              <button
                type="button"
                data-filter-ley={ley.codigo}
                title={ley.nombre}
                class="filter-chip rounded-full px-3 py-1 text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600"
              >
                {ley.codigo}
              </button>
            ))}
          </div>
        </div>

        <!-- Clear filters -->
        <div id="clear-filters-wrap" class="hidden pt-2 border-t border-gray-200 dark:border-gray-700">
          <button
            id="clear-filters"
            type="button"
            class="text-sm text-gray-500 hover:text-gray-700 dark:hover:text-gray-300"
          >
            Limpiar todos los filtros
          </button>
        </div>
      </div>

      <!-- Results -->
      <div id="search-results" class="mt-6">
        <p id="results-count" class="text-sm text-gray-500 mb-3"></p>
        <div id="results-list" class="space-y-2"></div>
      </div>

      <!-- Initial state message -->
      <div id="initial-message" class="mt-8 text-center text-gray-500 dark:text-gray-400">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <p>Escribe un término para buscar en todas las leyes</p>
        <p class="text-sm mt-2">Usa los filtros para refinar tu búsqueda</p>
      </div>
    </main>
  </div>
</BaseLayout>

<script is:inline define:vars={{ catalogoLeyes: catalogo.leyes }}>
  window.__CATALOGO_LEYES__ = catalogoLeyes;
</script>

<script>
  // Type for catalogo
  interface CatalogoLey {
    codigo: string;
    nombre: string;
    nombre_corto: string;
    tipo: string;
    categoria: string;
  }

  // State
  let pagefind: any = null;
  let selectedLeyes: string[] = [];
  const expandedLaws = new Set<string>();

  // Get catalogo from window (set by inline script)
  const catalogoLeyes: CatalogoLey[] = (window as any).__CATALOGO_LEYES__ || [];

  // Helper to get law info from catalogo
  function getLeyInfo(codigo: string): CatalogoLey | undefined {
    return catalogoLeyes.find(l => l.codigo.toUpperCase() === codigo?.toUpperCase());
  }

  // Get all law codes by category
  function getLeyesByCategoria(categoria: string): string[] {
    return catalogoLeyes.filter(l => l.categoria === categoria).map(l => l.codigo);
  }

  // Get all law codes by type
  function getLeyesByTipo(tipo: string): string[] {
    return catalogoLeyes.filter(l => l.tipo === tipo).map(l => l.codigo);
  }

  // Check if a category is fully active (all its laws are selected)
  function isCategoriaActive(categoria: string): boolean {
    const leyes = getLeyesByCategoria(categoria);
    return leyes.length > 0 && leyes.every(l => selectedLeyes.includes(l));
  }

  // Get all active categories
  function getActiveCategories(): string[] {
    return ['fiscal', 'laboral', 'constitucional'].filter(cat => isCategoriaActive(cat));
  }

  // Check if a type is fully active (ALL laws of that type selected, globally)
  // This is for visual state only - not scoped to categories
  function isTipoActive(tipo: string): boolean {
    const leyesOfType = getLeyesByTipo(tipo);
    return leyesOfType.length > 0 && leyesOfType.every(l => selectedLeyes.includes(l));
  }

  // Get laws to toggle for a tipo click (scoped to active categories context)
  function getLeyesToToggleForTipo(tipo: string): string[] {
    const activeCategories = getActiveCategories();

    if (activeCategories.length === 0) {
      // No category context, affect all laws of this type
      return getLeyesByTipo(tipo);
    } else {
      // Affect only laws within active categories
      return catalogoLeyes
        .filter(l => l.tipo === tipo && activeCategories.includes(l.categoria))
        .map(l => l.codigo);
    }
  }

  // Sync all chip visual states based on selectedLeyes
  function syncAllChips() {
    // Category chips
    document.querySelectorAll('[data-filter-categoria]').forEach((chip) => {
      const cat = (chip as HTMLElement).dataset.filterCategoria!;
      updateChipState(chip as HTMLElement, isCategoriaActive(cat));
    });

    // Type chips
    document.querySelectorAll('[data-filter-tipo]').forEach((chip) => {
      const tipo = (chip as HTMLElement).dataset.filterTipo!;
      updateChipState(chip as HTMLElement, isTipoActive(tipo));
    });

    // Law chips
    document.querySelectorAll('[data-filter-ley]').forEach((chip) => {
      const ley = (chip as HTMLElement).dataset.filterLey!;
      updateChipState(chip as HTMLElement, selectedLeyes.includes(ley));
    });
  }

  // Elements
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-btn');
  const filtersToggle = document.getElementById('filters-toggle');
  const filtersPanel = document.getElementById('filters-panel');
  const filterCount = document.getElementById('filter-count');
  const clearFiltersWrap = document.getElementById('clear-filters-wrap');
  const clearFiltersBtn = document.getElementById('clear-filters');
  const resultsDiv = document.getElementById('search-results');
  const resultsCount = document.getElementById('results-count');
  const resultsList = document.getElementById('results-list');
  const initialMessage = document.getElementById('initial-message');

  // Initialize Pagefind
  async function initPagefind() {
    if (pagefind) return pagefind;
    try {
      const importPagefind = new Function('return import("/pagefind/pagefind.js")');
      pagefind = await importPagefind();
      await pagefind.init();
      return pagefind;
    } catch (e) {
      console.error('Failed to load Pagefind:', e);
      return null;
    }
  }

  // Update URL with current state
  function updateURL() {
    const params = new URLSearchParams();
    if (input.value) params.set('q', input.value);
    if (selectedLeyes.length > 0) params.set('ley', selectedLeyes.join(','));

    const newURL = params.toString() ? `?${params.toString()}` : window.location.pathname;
    window.history.replaceState({}, '', newURL);
  }

  // Read URL params on load
  function readURLParams() {
    const params = new URLSearchParams(window.location.search);

    const q = params.get('q');
    if (q) {
      input.value = q;
      clearBtn?.classList.remove('hidden');
    }

    const leyParam = params.get('ley');
    if (leyParam) {
      selectedLeyes = leyParam.split(',').filter(Boolean);
    }

    // Sync all chip states based on selectedLeyes
    syncAllChips();
    updateFilterCount();

    // If there's a query, perform search and show filters panel
    if (q) {
      if (selectedLeyes.length > 0) {
        filtersPanel?.classList.remove('hidden');
      }
      doSearch(q);
    }
  }

  // Perform search
  async function doSearch(query: string) {
    if (!query.trim()) {
      resultsDiv?.classList.add('hidden');
      initialMessage?.classList.remove('hidden');
      return;
    }

    initialMessage?.classList.add('hidden');

    const pf = await initPagefind();
    if (!pf) return;

    let allResults: any[] = [];
    const seenUrls = new Set<string>();

    if (selectedLeyes.length === 0) {
      // No filter, search all
      const search = await pf.search(query);
      allResults = search.results;
    } else {
      // Search only in selected laws
      for (const ley of selectedLeyes) {
        const search = await pf.search(query, { filters: { ley } });
        for (const result of search.results) {
          const data = await result.data();
          if (!seenUrls.has(data.url)) {
            seenUrls.add(data.url);
            allResults.push(result);
          }
        }
      }
    }

    resultsDiv?.classList.remove('hidden');

    if (allResults.length === 0) {
      if (resultsCount) resultsCount.textContent = `No se encontraron resultados para "${query}"`;
      if (resultsList) resultsList.innerHTML = '';
      return;
    }

    // Load result data with sub_results
    const loaded = await Promise.all(
      allResults.slice(0, 30).map((r: any) => r.data())
    );

    // Build grouped results using sub_results from Pagefind
    interface SubResult {
      url: string;
      title: string;
      excerpt: string;
    }

    interface GroupedResult {
      url: string;
      meta: any;
      subResults: SubResult[];
    }

    interface LawGroup {
      ley: string;
      leyNombre: string;
      leyNombreCorto: string;
      categoria: string;
      tipo: string;
      articles: GroupedResult[];
      totalMatches: number;
    }

    const groupedResults: GroupedResult[] = loaded.map((result: any) => {
      const subResults: SubResult[] = [];

      // If result has sub_results, use them
      if (result.sub_results && result.sub_results.length > 0) {
        for (const sub of result.sub_results) {
          // Clean excerpt: remove duplicate title at the start
          let cleanExcerpt = sub.excerpt || '';
          const title = sub.title || '';
          if (title && cleanExcerpt.toLowerCase().startsWith(title.toLowerCase())) {
            cleanExcerpt = cleanExcerpt.slice(title.length).replace(/^[\s.,;:\-]+/, '');
          }
          subResults.push({
            url: sub.url || result.url,
            title: title,
            excerpt: cleanExcerpt
          });
        }
      } else {
        // Fallback: use main result as single sub-result
        subResults.push({
          url: result.url,
          title: '',
          excerpt: result.excerpt
        });
      }

      return {
        url: result.url,
        meta: result.meta,
        subResults
      };
    });

    // Group articles by law
    function groupByLaw(articles: GroupedResult[]): LawGroup[] {
      const lawGroups: Record<string, LawGroup> = {};

      for (const article of articles) {
        const ley = article.meta?.ley || 'unknown';
        if (!lawGroups[ley]) {
          const leyInfo = getLeyInfo(ley);
          lawGroups[ley] = {
            ley,
            leyNombre: leyInfo?.nombre || ley,
            leyNombreCorto: leyInfo?.nombre_corto || ley,
            categoria: leyInfo?.categoria || article.meta?.categoria || '',
            tipo: leyInfo?.tipo || '',
            articles: [],
            totalMatches: 0
          };
          // Expand all laws by default
          expandedLaws.add(ley);
        }
        lawGroups[ley].articles.push(article);
        lawGroups[ley].totalMatches += article.subResults.length;
      }

      // Sort by total matches descending
      return Object.values(lawGroups).sort((a, b) => b.totalMatches - a.totalMatches);
    }

    const lawGroups = groupByLaw(groupedResults);

    // Count total sub-results
    const totalSubResults = groupedResults.reduce((acc, g) => acc + g.subResults.length, 0);

    if (resultsCount) {
      resultsCount.textContent = `${totalSubResults} ${totalSubResults === 1 ? 'coincidencia' : 'coincidencias'} en ${groupedResults.length} ${groupedResults.length === 1 ? 'artículo' : 'artículos'} de ${lawGroups.length} ${lawGroups.length === 1 ? 'ley' : 'leyes'}`;
    }

    // Category color mapping
    const categoryColors: Record<string, string> = {
      fiscal: 'bg-emerald-600',
      laboral: 'bg-blue-600',
      constitucional: 'bg-orange-600'
    };

    const totalLawGroups = lawGroups.length;

    if (resultsList) {
      resultsList.innerHTML = lawGroups.map((lawGroup) => {
        const catColor = categoryColors[lawGroup.categoria] || 'bg-primary-600';
        const isExpanded = expandedLaws.has(lawGroup.ley);
        const canExclude = totalLawGroups > 1;

        return `
        <div class="law-group rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
          <!-- Law Header -->
          <div class="flex items-center bg-gray-50 dark:bg-gray-800/50">
            <button
              type="button"
              data-toggle-law="${lawGroup.ley}"
              class="flex-1 flex items-center gap-3 p-4 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left"
            >
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm font-bold text-white ${catColor}">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold text-gray-900 dark:text-gray-100">${lawGroup.ley}</span>
                  <span class="text-sm text-gray-500 dark:text-gray-400 truncate">${lawGroup.leyNombreCorto}</span>
                </div>
                <p class="text-sm text-gray-500">${lawGroup.totalMatches} ${lawGroup.totalMatches === 1 ? 'coincidencia' : 'coincidencias'} en ${lawGroup.articles.length} ${lawGroup.articles.length === 1 ? 'artículo' : 'artículos'}</p>
              </div>
              <svg class="chevron h-5 w-5 text-gray-400 transition-transform ${isExpanded ? 'rotate-180' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            ${canExclude ? `
            <button
              type="button"
              data-exclude-law="${lawGroup.ley}"
              class="p-3 mr-2 rounded-full hover:bg-red-100 dark:hover:bg-red-900/30 text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
              title="Excluir ${lawGroup.ley} de los resultados"
            >
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            ` : ''}
          </div>

          <!-- Articles (collapsible) -->
          <div class="law-content divide-y divide-gray-100 dark:divide-gray-800 ${isExpanded ? '' : 'hidden'}">
            ${lawGroup.articles.map((article) => `
              <div class="p-4">
                <a href="${article.url}" class="font-semibold text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400">${article.meta?.title || 'Sin título'}</a>
                ${article.meta?.seccion ? `<div class="text-sm font-medium text-gray-600 dark:text-gray-400 mb-2">${article.meta.seccion}</div>` : ''}
                <div class="space-y-2 mt-2">
                  ${article.subResults.map((sub) => `
                    <a href="${sub.url}" class="block p-2 rounded bg-gray-50 dark:bg-gray-800 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                      ${sub.title ? `<span class="text-xs font-medium text-primary-600 dark:text-primary-400">${sub.title}</span>` : ''}
                      <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">${sub.excerpt}</p>
                    </a>
                  `).join('')}
                </div>
              </div>
            `).join('')}
          </div>
        </div>`;
      }).join('');

      // Add toggle event listeners to new law headers
      document.querySelectorAll('[data-toggle-law]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const ley = (btn as HTMLElement).dataset.toggleLaw!;
          const lawGroup = btn.closest('.law-group') as HTMLElement;
          const content = lawGroup?.querySelector('.law-content') as HTMLElement;
          const chevron = btn.querySelector('.chevron') as HTMLElement;

          if (expandedLaws.has(ley)) {
            expandedLaws.delete(ley);
            content?.classList.add('hidden');
            chevron?.classList.remove('rotate-180');
          } else {
            expandedLaws.add(ley);
            content?.classList.remove('hidden');
            chevron?.classList.add('rotate-180');
          }
        });
      });

      // Add exclude event listeners
      document.querySelectorAll('[data-exclude-law]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const leyToExclude = (btn as HTMLElement).dataset.excludeLaw!;

          // Get all laws currently in results
          const currentLaws = Array.from(document.querySelectorAll('[data-toggle-law]'))
            .map(el => (el as HTMLElement).dataset.toggleLaw!);

          // Filter out the excluded law
          const remainingLaws = currentLaws.filter(l => l !== leyToExclude);

          if (remainingLaws.length === 0) return; // Safety check

          // Update selectedLeyes
          selectedLeyes = remainingLaws;

          // Update chip visual states in filter panel
          document.querySelectorAll('[data-filter-ley]').forEach((chip) => {
            const chipLey = (chip as HTMLElement).dataset.filterLey!;
            updateChipState(chip as HTMLElement, remainingLaws.includes(chipLey));
          });

          // Show filters panel for feedback
          filtersPanel?.classList.remove('hidden');

          // Update UI and re-search
          updateFilterCount();
          updateURL();
          doSearch(input.value);
        });
      });
    }

    updateURL();
  }

  // Update filter count badge
  function updateFilterCount() {
    const total = selectedLeyes.length;
    if (filterCount) {
      filterCount.textContent = total.toString();
      filterCount.classList.toggle('hidden', total === 0);
    }
    clearFiltersWrap?.classList.toggle('hidden', total === 0);
  }

  // Update chip visual state
  function updateChipState(btn: HTMLElement, active: boolean) {
    if (active) {
      const color = btn.dataset.color || 'bg-primary-600';
      btn.classList.remove('bg-gray-100', 'text-gray-700', 'dark:bg-gray-700', 'dark:text-gray-300');
      btn.classList.add(color, 'text-white');
    } else {
      const color = btn.dataset.color || 'bg-primary-600';
      btn.classList.remove(color, 'text-white');
      btn.classList.add('bg-gray-100', 'text-gray-700', 'dark:bg-gray-700', 'dark:text-gray-300');
    }
  }

  // Event: Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    doSearch(input.value);
  });

  // Event: Input change
  input?.addEventListener('input', () => {
    clearBtn?.classList.toggle('hidden', !input.value);
  });

  // Event: Clear input
  clearBtn?.addEventListener('click', () => {
    input.value = '';
    clearBtn.classList.add('hidden');
    resultsDiv?.classList.add('hidden');
    initialMessage?.classList.remove('hidden');
    updateURL();
    input.focus();
  });

  // Event: Toggle filters
  filtersToggle?.addEventListener('click', () => {
    filtersPanel?.classList.toggle('hidden');
  });

  // Event: Filter chip clicks - Categorias (shortcut to toggle all laws of category)
  document.querySelectorAll('[data-filter-categoria]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const categoria = (btn as HTMLElement).dataset.filterCategoria!;
      const leyesOfCategoria = getLeyesByCategoria(categoria);

      if (isCategoriaActive(categoria)) {
        // Remove all laws of this category
        selectedLeyes = selectedLeyes.filter(l => !leyesOfCategoria.includes(l));
      } else {
        // Add all laws of this category
        selectedLeyes = [...new Set([...selectedLeyes, ...leyesOfCategoria])];
      }

      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input.value) doSearch(input.value);
    });
  });

  // Event: Filter chip clicks - Tipos (shortcut to toggle all laws of type within context)
  document.querySelectorAll('[data-filter-tipo]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tipo = (btn as HTMLElement).dataset.filterTipo!;
      const leyesToToggle = getLeyesToToggleForTipo(tipo);

      if (leyesToToggle.length === 0) return; // Nothing to toggle

      // Check if all laws to toggle are currently selected
      const allSelected = leyesToToggle.every(l => selectedLeyes.includes(l));

      if (allSelected) {
        // Remove all laws of this type (within context)
        selectedLeyes = selectedLeyes.filter(l => !leyesToToggle.includes(l));
      } else {
        // Add all laws of this type (within context)
        selectedLeyes = [...new Set([...selectedLeyes, ...leyesToToggle])];
      }

      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input.value) doSearch(input.value);
    });
  });

  // Event: Filter chip clicks - Leyes (individual law toggle)
  document.querySelectorAll('[data-filter-ley]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const ley = (btn as HTMLElement).dataset.filterLey!;
      const idx = selectedLeyes.indexOf(ley);
      if (idx >= 0) {
        selectedLeyes.splice(idx, 1);
      } else {
        selectedLeyes.push(ley);
      }

      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input.value) doSearch(input.value);
    });
  });

  // Event: Clear all filters
  clearFiltersBtn?.addEventListener('click', () => {
    selectedLeyes = [];
    syncAllChips();
    updateFilterCount();
    updateURL();
    if (input.value) doSearch(input.value);
  });

  // Event: Keyboard shortcut "/"
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      input?.focus();
    }
  });

  // Initialize on page load
  readURLParams();
</script>
