---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchInput from '../components/SearchInput.astro';
import catalogo from '../data/catalogo.json';
import { categoriasDef, tiposDef, tipoStyles, categoryColors } from '../lib/theme';

// Get law data with categoria and tipo for styling
const leyes = catalogo.leyes.map(l => ({
  codigo: l.codigo,
  nombre: l.nombre,
  categoria: l.categoria,
  tipo: l.tipo,
}));

// Use centralized definitions
const tiposDocumento = tiposDef;
const categorias = categoriasDef;

// Theme data for client-side (incluye tipoStyles para fontClass)
const themeData = { categoryColors, tipoStyles };
---

<BaseLayout title="Buscar - LeyesMX" description="Busca artículos en leyes fiscales y laborales de México">
  <div class="min-h-screen flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-20 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="container mx-auto max-w-4xl flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-primary-600 hover:text-primary-700 font-semibold">
          <svg class="w-6 h-6" viewBox="0 0 32 32" fill="currentColor">
            <rect width="32" height="32" rx="6" fill="currentColor"/>
            <text x="16" y="22" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="white">LM</text>
          </svg>
          <span>LeyesMX</span>
        </a>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1 container mx-auto max-w-4xl px-4 py-8">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Buscar</h1>

      <!-- Search with typeahead -->
      <div id="search-container">
        <SearchInput
          id="search-input"
          placeholder="Buscar en leyes fiscales y laborales..."
          autofocus={true}
          showSubmitButton={true}
          onSubmit="event"
        />

        <!-- Filters toggle -->
        <div class="mt-2 flex items-center gap-2 text-sm text-gray-500">
          <button
            id="filters-toggle"
            type="button"
            class="flex items-center gap-1 rounded-lg px-2 py-1 hover:bg-gray-100 dark:hover:bg-gray-800"
          >
            Filtros
            <span id="filter-count" class="hidden ml-1 rounded-full bg-primary-100 px-2 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900 dark:text-primary-300">0</span>
          </button>
          <button
            id="clear-filters-inline"
            type="button"
            class="hidden items-center gap-1 px-2 py-1 rounded-lg text-sm text-gray-500 hover:text-red-600 hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Limpiar
          </button>
          <span class="text-gray-400">
            Presiona <kbd class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs dark:bg-gray-700">/</kbd> para buscar
          </span>
        </div>
      </div>

      <!-- Filters panel -->
      <div id="filters-panel" class="hidden mt-2 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-700 dark:bg-gray-800 space-y-3">
        <!-- Filter by category -->
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-2">Categoría</label>
          <div class="flex flex-wrap gap-2">
            {categorias.map((cat) => {
              const catColors = categoryColors[cat.value as keyof typeof categoryColors];
              const textColor = catColors?.text || 'text-gray-700';
              const textColorDark = catColors?.textDark || 'dark:text-gray-300';
              return (
                <button
                  type="button"
                  data-filter-categoria={cat.value}
                  data-color={cat.color}
                  data-text-color={textColor}
                  data-text-color-dark={textColorDark}
                  class={`filter-chip rounded-full px-3 py-1 text-sm font-semibold transition-colors bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 ${textColor} ${textColorDark}`}
                >
                  {cat.label}
                </button>
              );
            })}
          </div>
        </div>

        <!-- Filter by document type -->
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-2">Tipo de documento</label>
          <div class="flex flex-wrap gap-2">
            {tiposDocumento.map((tipo) => {
              const fontClass = tipoStyles[tipo.value as keyof typeof tipoStyles]?.fontClass || '';
              return (
                <button
                  type="button"
                  data-filter-tipo={tipo.value}
                  data-is-tipo="true"
                  class={`filter-chip rounded-full px-3 py-1 text-sm transition-colors bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600 ${fontClass}`}
                >
                  {tipo.label}
                </button>
              );
            })}
          </div>
        </div>

        <!-- Filter by specific law -->
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-2">Ley específica</label>
          <div class="flex flex-wrap gap-2">
            {leyes.map((ley) => {
              const fontClass = tipoStyles[ley.tipo as keyof typeof tipoStyles]?.fontClass || '';
              const catColors = categoryColors[ley.categoria as keyof typeof categoryColors];
              const textColor = catColors?.text || 'text-gray-700';
              const textColorDark = catColors?.textDark || 'dark:text-gray-300';
              return (
                <button
                  type="button"
                  data-filter-ley={ley.codigo}
                  data-categoria={ley.categoria}
                  data-tipo={ley.tipo}
                  data-text-color={textColor}
                  data-text-color-dark={textColorDark}
                  title={ley.nombre}
                  class={`filter-chip rounded-full px-3 py-1 text-sm transition-colors bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 ${fontClass} ${textColor} ${textColorDark}`}
                >
                  {ley.codigo}
                </button>
              );
            })}
          </div>
        </div>

      </div>

      <!-- Results -->
      <div id="search-results" class="mt-6">
        <p id="results-count" class="text-sm text-gray-500 mb-3"></p>
        <div id="results-list" class="space-y-2"></div>
      </div>

      <!-- Initial state message -->
      <div id="initial-message" class="mt-8 text-center text-gray-500 dark:text-gray-400">
        <svg class="w-16 h-16 mx-auto mb-4 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <p>Escribe un término para buscar en todas las leyes</p>
        <p class="text-sm mt-2">Usa los filtros para refinar tu búsqueda</p>
      </div>
    </main>
  </div>
</BaseLayout>

<script is:inline define:vars={{ catalogoLeyes: catalogo.leyes, themeData }}>
  window.__CATALOGO_LEYES__ = catalogoLeyes;
  window.__THEME__ = themeData;
</script>

<script>
  import MiniSearch from 'minisearch';
  import { parseDSL, formatRef, refToUrl, LEYES_VALIDAS, type RefArticulo } from '../lib/dsl-parser';

  // TOC index structure (from toc-index.json)
  interface TocItem {
    n: number;  // numero (párrafo)
    t: string;  // tipo
    i: string;  // identificador
    p?: number; // padre_numero
  }
  type TocIndex = Record<string, Record<string, TocItem[]>>;

  // Cache for TOC index
  let tocIndex: TocIndex | null = null;

  // Load consolidated TOC index
  async function loadTocIndex(): Promise<TocIndex> {
    if (tocIndex) return tocIndex;

    try {
      const res = await fetch('/toc-index.json');
      if (!res.ok) return {};
      tocIndex = await res.json();
      return tocIndex!;
    } catch {
      return {};
    }
  }

  // Resolve paragraph number for a reference using TOC index
  async function resolveParrafo(ref: RefArticulo): Promise<number | null> {
    const toc = await loadTocIndex();
    const leyToc = toc[ref.ley.toLowerCase()];
    if (!leyToc) return null;

    const items = leyToc[ref.articulo];
    if (!items || items.length === 0) return null;

    // If no modifiers, return first paragraph (1)
    if (!ref.apartado && !ref.fraccion && !ref.inciso && !ref.numeral) {
      return 1;
    }

    // Find apartado first if specified
    let padreNumero: number | null = null;
    if (ref.apartado) {
      const apartado = items.find(item =>
        item.t === 'apartado' && item.i === ref.apartado
      );
      if (!apartado) return 1;
      padreNumero = apartado.n;

      // If only apartado, return it
      if (!ref.fraccion) return apartado.n;
    }

    // Find fraccion
    if (ref.fraccion) {
      const fraccion = items.find(item =>
        item.t === 'fraccion' &&
        item.i === ref.fraccion &&
        (padreNumero === null || item.p === padreNumero)
      );
      if (!fraccion) return padreNumero || 1;
      padreNumero = fraccion.n;

      // If only fraccion (no inciso), return it
      if (!ref.inciso) return fraccion.n;
    }

    // Find inciso
    if (ref.inciso) {
      const inciso = items.find(item =>
        item.t === 'inciso' &&
        item.i === ref.inciso &&
        (padreNumero === null || item.p === padreNumero)
      );
      if (!inciso) return padreNumero || 1;
      padreNumero = inciso.n;

      // If only inciso (no numeral), return it
      if (!ref.numeral) return inciso.n;
    }

    // Find numeral
    if (ref.numeral) {
      const numeral = items.find(item =>
        item.t === 'numeral' &&
        item.i === ref.numeral &&
        (padreNumero === null || item.p === padreNumero)
      );
      if (numeral) return numeral.n;
    }

    return padreNumero || 1;
  }

  // Types
  interface CatalogoLey {
    codigo: string;
    nombre: string;
    nombre_corto: string;
    tipo: string;
    categoria: string;
  }

  interface SearchResult {
    id: number;
    ley: string;
    tipo: string;
    categoria: string;
    articuloNumero: string;
    articuloTitulo: string;
    parrafoLabel: string;
    parrafoTipo: string;
    seccion: string;
    url: string;
    score: number;
    match: Record<string, string[]>;
    pagina: number;
    posY: number;
  }

  interface ExcerptData {
    id: number;
    contenido: string;
  }

  // State
  let miniSearch: MiniSearch | null = null;
  let excerptMap: Map<number, string> = new Map();
  let searchLoading: Promise<void> | null = null;
  let selectedLeyes: string[] = [];
  const expandedLaws = new Set<string>();

  // Get catalogo from window
  const catalogoLeyes: CatalogoLey[] = (window as any).__CATALOGO_LEYES__ || [];

  // Helper functions
  function getLeyInfo(codigo: string): CatalogoLey | undefined {
    return catalogoLeyes.find(l => l.codigo.toUpperCase() === codigo?.toUpperCase());
  }

  function getLeyesByCategoria(categoria: string): string[] {
    return catalogoLeyes.filter(l => l.categoria === categoria).map(l => l.codigo);
  }

  function getLeyesByTipo(tipo: string): string[] {
    return catalogoLeyes.filter(l => l.tipo === tipo).map(l => l.codigo);
  }

  function isCategoriaActive(categoria: string): boolean {
    const leyes = getLeyesByCategoria(categoria);
    return leyes.length > 0 && leyes.every(l => selectedLeyes.includes(l));
  }

  function getActiveCategories(): string[] {
    return ['fiscal', 'laboral', 'constitucional'].filter(cat => isCategoriaActive(cat));
  }

  function isTipoActive(tipo: string): boolean {
    const leyesOfType = getLeyesByTipo(tipo);
    return leyesOfType.length > 0 && leyesOfType.every(l => selectedLeyes.includes(l));
  }

  function getLeyesToToggleForTipo(tipo: string): string[] {
    const activeCategories = getActiveCategories();
    if (activeCategories.length === 0) {
      return getLeyesByTipo(tipo);
    }
    const scopedLaws = catalogoLeyes
      .filter(l => l.tipo === tipo && activeCategories.includes(l.categoria))
      .map(l => l.codigo);
    return scopedLaws.length === 0 ? getLeyesByTipo(tipo) : scopedLaws;
  }

  function syncAllChips() {
    document.querySelectorAll('[data-filter-categoria]').forEach((chip) => {
      const cat = (chip as HTMLElement).dataset.filterCategoria!;
      updateChipState(chip as HTMLElement, isCategoriaActive(cat));
    });
    document.querySelectorAll('[data-filter-tipo]').forEach((chip) => {
      const tipo = (chip as HTMLElement).dataset.filterTipo!;
      updateChipState(chip as HTMLElement, isTipoActive(tipo));
    });
    document.querySelectorAll('[data-filter-ley]').forEach((chip) => {
      const ley = (chip as HTMLElement).dataset.filterLey!;
      updateChipState(chip as HTMLElement, selectedLeyes.includes(ley));
    });
  }

  // Get fresh DOM elements (needed for View Transitions)
  function getElements() {
    return {
      searchContainer: document.getElementById('search-container'),
      input: document.querySelector('#search-container .search-input') as HTMLInputElement,
      filtersToggle: document.getElementById('filters-toggle'),
      filtersPanel: document.getElementById('filters-panel'),
      filterCount: document.getElementById('filter-count'),
      clearFiltersInline: document.getElementById('clear-filters-inline'),
      resultsDiv: document.getElementById('search-results'),
      resultsCount: document.getElementById('results-count'),
      resultsList: document.getElementById('results-list'),
      initialMessage: document.getElementById('initial-message')
    };
  }

  // Initialize MiniSearch
  async function initSearch(): Promise<void> {
    if (miniSearch) return;
    if (searchLoading) return searchLoading;

    searchLoading = (async () => {
      try {
        // Load index and excerpts in parallel
        const [indexRes, excerptRes] = await Promise.all([
          fetch('/search-index.json'),
          fetch('/search-excerpts.json')
        ]);

        const indexData = await indexRes.json();
        const excerptData: ExcerptData[] = await excerptRes.json();

        // Load MiniSearch from serialized index
        miniSearch = MiniSearch.loadJSON(JSON.stringify(indexData), {
          fields: ['contenido', 'articuloTitulo', 'articuloNumero'],
          storeFields: [
            'ley', 'tipo', 'categoria',
            'articuloNumero', 'articuloTitulo',
            'parrafoLabel', 'parrafoTipo',
            'seccion', 'url'
          ]
        });

        // Build excerpt map
        excerptMap = new Map(excerptData.map(e => [e.id, e.contenido]));

        console.log('[MiniSearch] Índice cargado:', miniSearch.documentCount, 'documentos');
      } catch (e) {
        console.error('[MiniSearch] Error cargando índice:', e);
        searchLoading = null;
      }
    })();

    return searchLoading;
  }

  // Generate excerpt with highlighted terms
  function generateExcerpt(contenido: string, query: string, matchedTerms: string[] = [], maxLength = 200): string {
    // Use matched terms from MiniSearch if available, otherwise parse query
    const queryTerms = query.toLowerCase().split(/\s+/).filter(t => t.length > 2);
    const allTerms = [...new Set([...matchedTerms, ...queryTerms])];
    const contenidoLower = contenido.toLowerCase();

    // Find first occurrence of any term (try matched terms first)
    let bestPos = 0;
    let foundTerm = '';
    for (const term of allTerms) {
      const pos = contenidoLower.indexOf(term.toLowerCase());
      if (pos >= 0) {
        bestPos = Math.max(0, pos - maxLength / 2);
        foundTerm = term;
        break;
      }
    }

    // If no exact match, try partial match (stem)
    if (!foundTerm) {
      for (const term of allTerms) {
        const stem = term.toLowerCase().substring(0, Math.min(5, term.length));
        const pos = contenidoLower.indexOf(stem);
        if (pos >= 0) {
          bestPos = Math.max(0, pos - maxLength / 2);
          break;
        }
      }
    }

    // Extract excerpt
    let start = Math.floor(bestPos);
    let excerpt = contenido.substring(start, start + maxLength);

    // Clean up boundaries
    if (start > 0) excerpt = '...' + excerpt.replace(/^\S*\s/, '');
    if (start + maxLength < contenido.length) excerpt = excerpt.replace(/\s\S*$/, '') + '...';

    // Highlight all terms (including stems)
    for (const term of allTerms) {
      const stem = term.toLowerCase().substring(0, Math.min(4, term.length));
      const regex = new RegExp(`(${stem}\\w*)`, 'gi');
      excerpt = excerpt.replace(regex, '<mark>$1</mark>');
    }

    return excerpt;
  }

  // Update URL
  function updateURL() {
    const { input } = getElements();
    const params = new URLSearchParams();
    if (input?.value) params.set('q', input.value);
    if (selectedLeyes.length > 0) params.set('ley', selectedLeyes.join(','));
    const newURL = params.toString() ? `?${params.toString()}` : window.location.pathname;
    window.history.replaceState({}, '', newURL);
  }

  // Read URL params and initialize search
  function readURLParams() {
    const { input, clearBtn, filtersPanel } = getElements();
    if (!input) return; // Element not found, page not ready

    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      input.value = q;
      clearBtn?.classList.remove('hidden');
    }
    const leyParam = params.get('ley');
    if (leyParam) {
      selectedLeyes = leyParam.split(',').filter(Boolean);
    }
    syncAllChips();
    updateFilterCount();
    if (q) {
      if (selectedLeyes.length > 0) filtersPanel?.classList.remove('hidden');
      doSearch(q);
    }
  }

  // Check if query is DSL format (e.g., "cpeum:94,97,116/III")
  function isDSLQuery(query: string): boolean {
    const match = query.match(/^([a-z]+):/i);
    if (!match) return false;
    return LEYES_VALIDAS.has(match[1].toLowerCase());
  }

  // Render DSL results (direct article links)
  async function renderDSLResults(query: string) {
    const { resultsDiv, initialMessage, resultsCount, resultsList } = getElements();

    const parsed = parseDSL(query);

    initialMessage?.classList.add('hidden');
    resultsDiv?.classList.remove('hidden');

    if (!parsed.success || parsed.referencias.length === 0) {
      if (resultsCount) resultsCount.textContent = parsed.error || 'Query DSL inválido';
      if (resultsList) resultsList.innerHTML = '';
      return;
    }

    const refs = parsed.referencias;

    if (resultsCount) {
      resultsCount.textContent = `${refs.length} artículo${refs.length > 1 ? 's' : ''} referenciado${refs.length > 1 ? 's' : ''}`;
    }

    // Resolve paragraph numbers for all references
    const resolvedRefs = await Promise.all(refs.map(async ref => ({
      ref,
      parrafo: await resolveParrafo(ref)
    })));

    // Group by law
    const byLaw = new Map<string, typeof resolvedRefs>();
    for (const item of resolvedRefs) {
      const ley = item.ref.ley.toUpperCase();
      if (!byLaw.has(ley)) byLaw.set(ley, []);
      byLaw.get(ley)!.push(item);
    }

    // Get law info helper
    const getLeyNombre = (codigo: string) => {
      const info = getLeyInfo(codigo);
      return info?.nombre_corto || info?.nombre || codigo;
    };

    // Category colors
    const catColors: Record<string, string> = {
      fiscal: 'bg-emerald-600',
      laboral: 'bg-blue-600',
      constitucional: 'bg-orange-600'
    };

    if (resultsList) {
      resultsList.innerHTML = Array.from(byLaw.entries()).map(([ley, leyRefs]) => {
        const leyInfo = getLeyInfo(ley);
        const catColor = catColors[leyInfo?.categoria || ''] || 'bg-primary-600';

        return `
        <div class="rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div class="flex items-center gap-3 p-4 bg-gray-50 dark:bg-gray-800/50">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm font-bold text-white ${catColor}">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div>
              <span class="font-semibold text-gray-900 dark:text-gray-100">${ley}</span>
              <span class="text-sm text-gray-500 dark:text-gray-400 ml-2">${getLeyNombre(ley)}</span>
            </div>
          </div>
          <div class="divide-y divide-gray-100 dark:divide-gray-800">
            ${leyRefs.map(({ ref, parrafo }) => {
              const baseUrl = refToUrl(ref);
              const url = parrafo ? `${baseUrl}#p-${parrafo}` : baseUrl;
              const label = formatRef(ref);
              return `
              <a href="${url}" class="flex items-center gap-3 p-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                <svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <span class="font-medium text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400">
                  ${label}
                </span>
              </a>`;
            }).join('')}
          </div>
        </div>`;
      }).join('');
    }

    updateURL();
  }

  // Perform search
  async function doSearch(query: string) {
    const { resultsDiv, initialMessage, resultsCount, resultsList } = getElements();

    if (!query.trim()) {
      resultsDiv?.classList.add('hidden');
      initialMessage?.classList.remove('hidden');
      return;
    }

    // Check for DSL query first
    if (isDSLQuery(query)) {
      await renderDSLResults(query);
      return;
    }

    initialMessage?.classList.add('hidden');
    await initSearch();

    if (!miniSearch) {
      if (resultsCount) resultsCount.textContent = 'Error cargando el índice de búsqueda';
      return;
    }

    // Search with MiniSearch
    let results = miniSearch.search(query, {
      prefix: true,
      fuzzy: 0.2,
      boost: { articuloTitulo: 2, articuloNumero: 1.5 }
    }) as SearchResult[];

    // Filter by selected laws if any
    if (selectedLeyes.length > 0) {
      results = results.filter(r => selectedLeyes.includes(r.ley));
    }

    resultsDiv?.classList.remove('hidden');

    if (results.length === 0) {
      if (resultsCount) resultsCount.textContent = `No se encontraron resultados para "${query}"`;
      if (resultsList) resultsList.innerHTML = '';
      return;
    }

    // Types for grouping
    interface ParrafoMatch {
      parrafoLabel: string;
      excerpt: string;
      url: string;
    }

    interface ArticleGroup {
      articuloNumero: string;
      articuloTitulo: string;
      url: string;
      parrafos: ParrafoMatch[];
    }

    interface SectionGroup {
      seccion: string;
      articles: Map<string, ArticleGroup>;
      totalMatches: number;
      minPagina: number;
      minPosY: number;
    }

    interface LawGroup {
      ley: string;
      leyNombre: string;
      leyNombreCorto: string;
      categoria: string;
      sections: Map<string, SectionGroup>;
      totalMatches: number;
    }

    // Group by law → section → article → paragraphs
    const lawGroups: Record<string, LawGroup> = {};
    const maxResults = 200; // Limit total results for performance

    for (const result of results.slice(0, maxResults)) {
      const ley = result.ley;
      const seccion = result.seccion || 'Sin sección';
      const artNum = result.articuloNumero;

      // Initialize law group
      if (!lawGroups[ley]) {
        const leyInfo = getLeyInfo(ley);
        lawGroups[ley] = {
          ley,
          leyNombre: leyInfo?.nombre || ley,
          leyNombreCorto: leyInfo?.nombre_corto || ley,
          categoria: leyInfo?.categoria || result.categoria,
          sections: new Map(),
          totalMatches: 0
        };
      }

      // Initialize section group
      if (!lawGroups[ley].sections.has(seccion)) {
        lawGroups[ley].sections.set(seccion, {
          seccion,
          articles: new Map(),
          totalMatches: 0,
          minPagina: Infinity,
          minPosY: Infinity
        });
      }

      // Update section's minimum position (for sorting by document order)
      const sectionGroup = lawGroups[ley].sections.get(seccion)!;
      const pagina = result.pagina || 0;
      const posY = result.posY || 0;
      if (pagina < sectionGroup.minPagina || (pagina === sectionGroup.minPagina && posY < sectionGroup.minPosY)) {
        sectionGroup.minPagina = pagina;
        sectionGroup.minPosY = posY;
      }

      // Initialize article group (URL base without hash)
      if (!sectionGroup.articles.has(artNum)) {
        const baseUrl = result.url.split('#')[0];
        sectionGroup.articles.set(artNum, {
          articuloNumero: artNum,
          articuloTitulo: result.articuloTitulo,
          url: baseUrl,
          parrafos: []
        });
      }

      // Add paragraph match (with hash URL)
      const contenido = excerptMap.get(result.id) || '';
      const excerpt = generateExcerpt(contenido, query);

      sectionGroup.articles.get(artNum)!.parrafos.push({
        parrafoLabel: result.parrafoLabel,
        excerpt,
        url: result.url  // Full URL with hash
      });
      sectionGroup.totalMatches++;
      lawGroups[ley].totalMatches++;
    }

    // Sort paragraphs within each article by paragraph number
    for (const group of Object.values(lawGroups)) {
      for (const section of group.sections.values()) {
        for (const article of section.articles.values()) {
          article.parrafos.sort((a, b) => {
            const numA = parseInt(a.url.match(/#p-(\d+)/)?.[1] || '0');
            const numB = parseInt(b.url.match(/#p-(\d+)/)?.[1] || '0');
            return numA - numB;
          });
        }
      }
    }

    // Convert to sorted arrays (sections sorted by page+y position)
    const sortedGroups = Object.values(lawGroups)
      .map(g => ({
        ...g,
        sections: Array.from(g.sections.values())
          .map(s => ({
            ...s,
            articles: Array.from(s.articles.values())
          }))
          .sort((a, b) => {
            // Sort by page first, then by y position
            if (a.minPagina !== b.minPagina) return a.minPagina - b.minPagina;
            return a.minPosY - b.minPosY;
          })
      }))
      .sort((a, b) => b.totalMatches - a.totalMatches);

    // Count unique articles and sections
    const totalMatches = results.length;
    const uniqueArticles = new Set(results.map(r => `${r.ley}-${r.articuloNumero}`)).size;
    const uniqueSections = new Set(results.map(r => `${r.ley}-${r.seccion}`)).size;

    // Expand first group and first section
    expandedLaws.clear();
    const expandedSections = new Set<string>();
    if (sortedGroups.length > 0) {
      expandedLaws.add(sortedGroups[0].ley);
      if (sortedGroups[0].sections.length > 0) {
        expandedSections.add(`${sortedGroups[0].ley}-${sortedGroups[0].sections[0].seccion}`);
      }
    }

    // Update count
    if (resultsCount) {
      resultsCount.textContent = `${totalMatches} coincidencias en ${uniqueArticles} artículos, ${uniqueSections} secciones de ${sortedGroups.length} ${sortedGroups.length === 1 ? 'ley' : 'leyes'}`;
    }

    // Category colors
    const catColors: Record<string, string> = {
      fiscal: 'bg-emerald-600',
      laboral: 'bg-blue-600',
      constitucional: 'bg-orange-600'
    };

    // Helper to generate section ID for toggling
    const getSectionId = (ley: string, seccion: string) => `${ley}-${seccion}`.replace(/\s+/g, '_');

    // Render results
    if (resultsList) {
      resultsList.innerHTML = sortedGroups.map((group) => {
        const catColor = catColors[group.categoria] || 'bg-primary-600';
        const isExpanded = expandedLaws.has(group.ley);
        const canExclude = sortedGroups.length > 1;
        const totalArticles = group.sections.reduce((sum, s) => sum + s.articles.length, 0);

        return `
        <div class="law-group rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div class="flex items-center bg-gray-50 dark:bg-gray-800/50">
            <button type="button" data-toggle-law="${group.ley}"
              class="flex-1 flex items-center gap-3 p-4 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-sm font-bold text-white ${catColor}">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-semibold text-gray-900 dark:text-gray-100">${group.ley}</span>
                  <span class="text-sm text-gray-500 dark:text-gray-400 truncate">${group.leyNombreCorto}</span>
                </div>
                <p class="text-sm text-gray-500">${group.totalMatches} coincidencias en ${totalArticles} artículos, ${group.sections.length} secciones</p>
              </div>
              <svg class="chevron h-5 w-5 text-gray-400 transition-transform ${isExpanded ? 'rotate-180' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            ${canExclude ? `
            <button type="button" data-exclude-law="${group.ley}"
              class="p-3 mr-2 rounded-full hover:bg-red-100 dark:hover:bg-red-900/30 text-gray-400 hover:text-red-600 dark:hover:text-red-400 transition-colors"
              title="Excluir ${group.ley} de los resultados">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
            ` : ''}
          </div>
          <div class="law-content ${isExpanded ? '' : 'hidden'}">
            ${group.sections.map((section, sIdx) => {
              const sectionId = getSectionId(group.ley, section.seccion);
              const isSectionExpanded = expandedSections.has(`${group.ley}-${section.seccion}`);
              return `
              <div class="section-group border-t border-gray-100 dark:border-gray-800">
                <button type="button" data-toggle-section="${sectionId}" data-law="${group.ley}" data-seccion="${section.seccion}"
                  class="w-full flex items-center gap-2 p-3 pl-4 bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left">
                  <svg class="section-chevron h-5 w-5 text-primary-500 transition-transform shrink-0 ${isSectionExpanded ? 'rotate-90' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  <div class="flex-1 min-w-0">
                    <span class="font-medium text-gray-900 dark:text-gray-100">${section.seccion}</span>
                  </div>
                  <span class="text-xs font-medium text-primary-600 dark:text-primary-400 shrink-0">${section.totalMatches} en ${section.articles.length} art.</span>
                </button>
                <div class="section-content pl-4 divide-y divide-gray-50 dark:divide-gray-800/50 ${isSectionExpanded ? '' : 'hidden'}">
                  ${section.articles.map((article) => `
                    <div class="article-group">
                      <a href="${article.url}" class="block p-3 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                        <div class="font-medium text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400">${article.articuloTitulo}</div>
                      </a>
                      <div class="pl-3 divide-y divide-gray-50 dark:divide-gray-800/50">
                        ${article.parrafos.map((p) => `
                          <a href="${p.url}" class="block p-2 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                            <span class="text-xs font-medium text-primary-600 dark:text-primary-400">${p.parrafoLabel}</span>
                            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1 line-clamp-2">${p.excerpt}</p>
                          </a>
                        `).join('')}
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>`;
            }).join('')}
          </div>
        </div>`;
      }).join('');

      // Add toggle listeners
      document.querySelectorAll('[data-toggle-law]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const ley = (btn as HTMLElement).dataset.toggleLaw!;
          const isOpen = expandedLaws.has(ley);

          // Close all
          document.querySelectorAll('.law-group').forEach((group) => {
            const content = group.querySelector('.law-content') as HTMLElement;
            const chevron = group.querySelector('.chevron') as HTMLElement;
            const groupLey = group.querySelector('[data-toggle-law]') as HTMLElement;
            if (groupLey?.dataset.toggleLaw) {
              expandedLaws.delete(groupLey.dataset.toggleLaw);
              content?.classList.add('hidden');
              chevron?.classList.remove('rotate-180');
            }
          });

          // Open clicked if was closed
          if (!isOpen) {
            const lawGroup = btn.closest('.law-group') as HTMLElement;
            const content = lawGroup?.querySelector('.law-content') as HTMLElement;
            const chevron = btn.querySelector('.chevron') as HTMLElement;
            expandedLaws.add(ley);
            content?.classList.remove('hidden');
            chevron?.classList.add('rotate-180');
          }
        });
      });

      // Add section toggle listeners
      document.querySelectorAll('[data-toggle-section]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sectionGroup = btn.closest('.section-group') as HTMLElement;
          const content = sectionGroup?.querySelector('.section-content') as HTMLElement;
          const chevron = btn.querySelector('.section-chevron') as HTMLElement;
          const isOpen = !content?.classList.contains('hidden');

          if (isOpen) {
            content?.classList.add('hidden');
            chevron?.classList.remove('rotate-90');
          } else {
            content?.classList.remove('hidden');
            chevron?.classList.add('rotate-90');
          }
        });
      });

      // Add exclude listeners
      document.querySelectorAll('[data-exclude-law]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const { input, filtersPanel } = getElements();
          const leyToExclude = (btn as HTMLElement).dataset.excludeLaw!;
          const baseLaws = selectedLeyes.length === 0
            ? catalogoLeyes.map(l => l.codigo)
            : selectedLeyes;
          const remainingLaws = baseLaws.filter(l => l !== leyToExclude);
          if (remainingLaws.length === 0) return;
          selectedLeyes = remainingLaws;
          syncAllChips();
          filtersPanel?.classList.remove('hidden');
          updateFilterCount();
          updateURL();
          if (input?.value) doSearch(input.value);
        });
      });
    }

    updateURL();
  }

  // Update filter count
  function updateFilterCount() {
    const { filterCount, clearFiltersInline } = getElements();
    const total = selectedLeyes.length;
    const hasSelections = total > 0;
    if (filterCount) {
      filterCount.textContent = total.toString();
      filterCount.classList.toggle('hidden', !hasSelections);
    }
    if (clearFiltersInline) {
      clearFiltersInline.classList.toggle('hidden', !hasSelections);
      clearFiltersInline.classList.toggle('flex', hasSelections);
    }
  }

  // Chip state
  const theme = (window as any).__THEME__ || { categoryColors: {} };

  function getChipColor(btn: HTMLElement): string {
    const categoria = btn.dataset.categoria;
    if (categoria && theme.categoryColors[categoria]) {
      return theme.categoryColors[categoria].bg;
    }
    return btn.dataset.color || 'bg-primary-600';
  }

  function updateChipState(btn: HTMLElement, active: boolean) {
    const isTipoChip = btn.dataset.isTipo === 'true';
    if (isTipoChip) {
      if (active) {
        btn.classList.remove('text-gray-600', 'dark:text-gray-300', 'opacity-50');
        btn.classList.add('ring-2', 'ring-primary-500', 'text-gray-900', 'dark:text-white');
      } else {
        btn.classList.remove('ring-2', 'ring-primary-500', 'text-gray-900', 'dark:text-white');
        btn.classList.add('text-gray-600', 'dark:text-gray-300', 'opacity-50');
      }
    } else {
      const bgColor = getChipColor(btn);
      const textColor = btn.dataset.textColor || 'text-gray-700';
      const textColorDark = btn.dataset.textColorDark || 'dark:text-gray-300';
      if (active) {
        btn.classList.remove('bg-gray-100', 'dark:bg-gray-700', textColor, textColorDark, 'opacity-50');
        btn.classList.add(bgColor, 'text-white');
      } else {
        btn.classList.remove(bgColor, 'text-white');
        btn.classList.add('bg-gray-100', 'dark:bg-gray-700', textColor, textColorDark, 'opacity-50');
      }
    }
  }

  // Event listeners using event delegation (works with View Transitions)

  // Listen for search-submit event from SearchInput component
  document.addEventListener('search-submit', (e) => {
    const detail = (e as CustomEvent).detail;
    if (detail?.query) {
      doSearch(detail.query);
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    // Filters toggle
    if (target.id === 'filters-toggle' || target.closest('#filters-toggle')) {
      const { filtersPanel } = getElements();
      filtersPanel?.classList.toggle('hidden');
    }
  });

  // Filter clicks using event delegation
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const { input } = getElements();

    // Category filter
    const catBtn = target.closest('[data-filter-categoria]') as HTMLElement;
    if (catBtn) {
      const categoria = catBtn.dataset.filterCategoria!;
      const leyesOfCategoria = getLeyesByCategoria(categoria);
      if (isCategoriaActive(categoria)) {
        selectedLeyes = selectedLeyes.filter(l => !leyesOfCategoria.includes(l));
      } else {
        selectedLeyes = [...new Set([...selectedLeyes, ...leyesOfCategoria])];
      }
      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input?.value) doSearch(input.value);
      return;
    }

    // Type filter
    const tipoBtn = target.closest('[data-filter-tipo]') as HTMLElement;
    if (tipoBtn) {
      const tipo = tipoBtn.dataset.filterTipo!;
      const leyesToToggle = getLeyesToToggleForTipo(tipo);
      if (leyesToToggle.length === 0) return;
      const allSelected = leyesToToggle.every(l => selectedLeyes.includes(l));
      if (allSelected) {
        selectedLeyes = selectedLeyes.filter(l => !leyesToToggle.includes(l));
      } else {
        selectedLeyes = [...new Set([...selectedLeyes, ...leyesToToggle])];
      }
      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input?.value) doSearch(input.value);
      return;
    }

    // Law filter
    const leyBtn = target.closest('[data-filter-ley]') as HTMLElement;
    if (leyBtn) {
      const ley = leyBtn.dataset.filterLey!;
      const idx = selectedLeyes.indexOf(ley);
      if (idx >= 0) {
        selectedLeyes.splice(idx, 1);
      } else {
        selectedLeyes.push(ley);
      }
      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input?.value) doSearch(input.value);
      return;
    }

    // Clear filters inline
    if (target.id === 'clear-filters-inline' || target.closest('#clear-filters-inline')) {
      selectedLeyes = [];
      syncAllChips();
      updateFilterCount();
      updateURL();
      if (input?.value) doSearch(input.value);
      return;
    }
  });

  // Initialize on page load and View Transitions
  document.addEventListener('astro:page-load', readURLParams);
  // Also call directly for initial load (handles race condition with module loading)
  readURLParams();
</script>
