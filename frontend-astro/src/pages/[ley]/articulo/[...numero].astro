---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FraccionesView from '../../../components/FraccionesView.astro';
import ArticleToc from '../../../components/ArticleToc.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import catalogo from '../../../data/catalogo.json';

interface BreadcrumbItem {
  tipo: string;
  numero: string;
  nombre: string | null;
  url: string;
}

export async function getStaticPaths() {
  // Function must be inside getStaticPaths for Astro build
  function findArticleBreadcrumb(divisiones: any[], articuloNumero: string, leyCode: string, parentPath: string[] = []): BreadcrumbItem[] | null {
    for (const div of divisiones) {
      const currentPath = [...parentPath, div.numero.toLowerCase().replace(/\s+/g, '-')];
      const url = `/${leyCode}/${div.tipo}/${currentPath.join('/')}`;

      // Check if article is in this division
      if (div.articulos && div.articulos.includes(articuloNumero)) {
        return [{ tipo: div.tipo, numero: div.numero, nombre: div.nombre, url }];
      }

      // Search in children
      if (div.hijos && div.hijos.length > 0) {
        const found = findArticleBreadcrumb(div.hijos, articuloNumero, leyCode, currentPath);
        if (found) {
          // Prepend current division
          return [{ tipo: div.tipo, numero: div.numero, nombre: div.nombre, url }, ...found];
        }
      }
    }
    return null;
  }

  const paths = [];

  for (const ley of catalogo.leyes) {
    const codigoLower = ley.codigo.toLowerCase();
    const articulosModule = await import(`../../../data/${codigoLower}/articulos.json`);
    const estructuraModule = await import(`../../../data/${codigoLower}/estructura.json`);
    const articulos = articulosModule.default;
    const estructura = estructuraModule.default;

    for (let i = 0; i < articulos.length; i++) {
      const articulo = articulos[i];
      const prevArt = i > 0 ? articulos[i - 1] : null;
      const nextArt = i < articulos.length - 1 ? articulos[i + 1] : null;

      // Find breadcrumb for this article
      const breadcrumb = estructura.divisiones
        ? findArticleBreadcrumb(estructura.divisiones, articulo.numero, codigoLower)
        : null;

      paths.push({
        params: { ley: codigoLower, numero: articulo.numero },
        props: {
          articulo,
          leyInfo: ley,
          prevArticulo: prevArt ? { numero: prevArt.numero } : null,
          nextArticulo: nextArt ? { numero: nextArt.numero } : null,
          totalArticulos: articulos.length,
          indiceActual: i + 1,
          breadcrumb: breadcrumb || []
        }
      });
    }
  }

  return paths;
}

interface Props {
  articulo: {
    numero: string;
    tipo: string;
    contenido: string;
    pagina: number;
    parrafos: Array<{
      numero: number;
      tipo: string;
      identificador: string | null;
      contenido: string;
      padre_numero: number | null;
    }>;
  };
  leyInfo: typeof catalogo.leyes[0];
  prevArticulo: { numero: string } | null;
  nextArticulo: { numero: string } | null;
  totalArticulos: number;
  indiceActual: number;
  breadcrumb: BreadcrumbItem[];
}

const { articulo, leyInfo, prevArticulo, nextArticulo, totalArticulos, indiceActual, breadcrumb } = Astro.props;
const codigoLower = leyInfo.codigo.toLowerCase();
const isDerogado = articulo.tipo === 'derogado';
const tieneParrafos = articulo.parrafos && articulo.parrafos.length > 0;

// Get last breadcrumb item for division indicator
const currentDivision = breadcrumb.length > 0 ? breadcrumb[breadcrumb.length - 1] : null;
---

<BaseLayout title={`Artículo ${articulo.numero} - ${leyInfo.codigo}`} article={true} hideFloatingToggle={true} description={`${leyInfo.nombre} - Artículo ${articulo.numero}. Texto completo y actualizado.`}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LegalDocument",
    "name": `Artículo ${articulo.numero}`,
    "description": `${leyInfo.nombre} - Artículo ${articulo.numero}`,
    "isPartOf": {
      "@type": "Legislation",
      "name": leyInfo.nombre,
      "alternateName": leyInfo.codigo
    },
    "inLanguage": "es-MX",
    "jurisdiction": "MX"
  })} />
  <div class="min-h-screen flex flex-col">
    <!-- Header fijo -->
    <header class="sticky top-0 z-20 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="container mx-auto max-w-5xl flex items-center justify-between gap-4">
        <!-- Logo + Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm min-w-0 flex-1 overflow-x-auto">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-1.5 text-primary-600 hover:text-primary-700 font-semibold whitespace-nowrap">
            <svg class="w-5 h-5" viewBox="0 0 32 32" fill="currentColor">
              <rect width="32" height="32" rx="6" fill="currentColor"/>
              <text x="16" y="22" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="white">LM</text>
            </svg>
            <span class="hidden sm:inline">LeyesMX</span>
          </a>

          <span class="text-gray-400">›</span>

          <!-- Ley badge -->
          <a href={`/${codigoLower}`} class="badge-ley whitespace-nowrap">
            {leyInfo.codigo}
          </a>

          <!-- Breadcrumb items -->
          {breadcrumb.map((item) => (
            <>
              <span class="text-gray-400">›</span>
              <a href={item.url} class="text-gray-600 dark:text-gray-400 hover:text-primary-600 whitespace-nowrap capitalize">
                {item.tipo} {item.numero}
              </a>
            </>
          ))}

          <span class="text-gray-400">›</span>

          <!-- Current article -->
          <span class="font-medium text-gray-900 dark:text-white whitespace-nowrap">
            Artículo {articulo.numero}
          </span>
        </nav>

        <!-- Right side: actions + counter + toggle -->
        <div class="flex items-center gap-2 flex-shrink-0">
          <!-- Copy button -->
          <button
            id="copy-btn"
            type="button"
            class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-gray-600 dark:text-gray-400"
            title="Copiar artículo"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>

          <!-- PDF button -->
          <a
            href={`/pdfs/${codigoLower}.pdf#page=${articulo.pagina}`}
            target="_blank"
            rel="noopener"
            class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-gray-600 dark:text-gray-400"
            title="Ver PDF en página {articulo.pagina}"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </a>

          <span class="text-sm text-gray-500 whitespace-nowrap ml-1">
            {indiceActual} / {totalArticulos}
          </span>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <!-- Contenido -->
    <main class="flex-1 container mx-auto max-w-4xl px-4 py-8 pb-24">
      <article id="article-content" data-pagefind-body>
        <!-- Division indicator -->
        {currentDivision && (
          <p class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">
            {currentDivision.tipo} {currentDivision.numero} {currentDivision.nombre ? `- ${currentDivision.nombre}` : ''}
          </p>
        )}

        <h1
          class="text-2xl font-bold text-primary-600 dark:text-primary-400 mb-2"
          data-pagefind-meta="title"
        >
          Artículo {articulo.numero}
        </h1>

        <!-- Law name -->
        <p class="text-gray-600 dark:text-gray-400 mb-6">{leyInfo.nombre}</p>

        <p class="hidden" data-pagefind-meta="ley">{leyInfo.codigo}</p>

        {/* TOC si tiene fracciones */}
        {tieneParrafos && !isDerogado && (
          <ArticleToc parrafos={articulo.parrafos} />
        )}

        <div id="legal-content">
          {isDerogado ? (
            <div class="p-4 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-500 dark:text-gray-400 italic">
              Artículo derogado
            </div>
          ) : tieneParrafos ? (
            <FraccionesView parrafos={articulo.parrafos} />
          ) : (
            <div class="prose-legal">
              <p class="text-gray-800 dark:text-gray-200 whitespace-pre-wrap">
                {articulo.contenido}
              </p>
            </div>
          )}
        </div>
      </article>
    </main>

    <!-- Footer fijo con navegación -->
    <footer class="sticky bottom-0 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="container mx-auto max-w-4xl flex items-center justify-between">
        {prevArticulo ? (
          <a
            href={`/${codigoLower}/articulo/${prevArticulo.numero}`}
            class="btn-secondary"
          >
            ← Art. {prevArticulo.numero}
          </a>
        ) : (
          <span></span>
        )}

        <a href={`/${codigoLower}`} class="text-sm text-gray-500 hover:text-primary-600">
          Ver índice
        </a>

        {nextArticulo ? (
          <a
            href={`/${codigoLower}/articulo/${nextArticulo.numero}`}
            class="btn-secondary"
          >
            Art. {nextArticulo.numero} →
          </a>
        ) : (
          <span></span>
        )}
      </div>
    </footer>
  </div>

  <!-- Copy script -->
  <script>
    const copyBtn = document.getElementById('copy-btn');
    const legalContent = document.getElementById('legal-content');

    copyBtn?.addEventListener('click', async () => {
      if (!legalContent) return;

      const text = legalContent.innerText;
      try {
        await navigator.clipboard.writeText(text);
        // Visual feedback
        copyBtn.classList.add('text-primary-600');
        setTimeout(() => copyBtn.classList.remove('text-primary-600'), 1500);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  </script>
</BaseLayout>
