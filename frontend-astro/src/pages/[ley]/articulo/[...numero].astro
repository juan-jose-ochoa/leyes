---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FraccionesView from '../../../components/FraccionesView.astro';
import ArticleToc from '../../../components/ArticleToc.astro';
import ArticleTocVertical from '../../../components/ArticleTocVertical.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import ReferenciasList from '../../../components/ReferenciasList.astro';
import PdfViewer from '../../../components/PdfViewer.astro';
import ViewModeToggle from '../../../components/ViewModeToggle.astro';
import ArticleNavigator from '../../../components/ArticleNavigator.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import catalogo from '../../../data/catalogo.json';
import epigrafesSat from '../../../data/epigrafes-sat.json';

interface BreadcrumbItem {
  tipo: string;
  numero: string;
  nombre: string | null;
  url: string;
  prevArticulo?: string | null;
  nextArticulo?: string | null;
}

export async function getStaticPaths() {
  // Function must be inside getStaticPaths for Astro build
  function findArticleBreadcrumb(divisiones: any[], articuloNumero: string, leyCode: string, parentPath: string[] = []): BreadcrumbItem[] | null {
    for (const div of divisiones) {
      const currentPath = [...parentPath, div.numero.toLowerCase().replace(/\s+/g, '-')];
      const url = `/${leyCode}/${div.tipo}/${currentPath.join('/')}/`;

      // Check if article is in this division
      if (div.articulos && div.articulos.includes(articuloNumero)) {
        return [{ tipo: div.tipo, numero: div.numero, nombre: div.nombre, url }];
      }

      // Search in children
      if (div.hijos && div.hijos.length > 0) {
        const found = findArticleBreadcrumb(div.hijos, articuloNumero, leyCode, currentPath);
        if (found) {
          // Prepend current division
          return [{ tipo: div.tipo, numero: div.numero, nombre: div.nombre, url }, ...found];
        }
      }
    }
    return null;
  }

  // Get division identifier at a specific level from breadcrumb
  function getDivisionId(breadcrumb: BreadcrumbItem[] | null, level: number): string | null {
    if (!breadcrumb || breadcrumb.length <= level) return null;
    return `${breadcrumb[level].tipo}-${breadcrumb[level].numero}`;
  }

  const paths = [];

  for (const ley of catalogo.leyes) {
    const codigoLower = ley.codigo.toLowerCase();
    const articulosModule = await import(`../../../data/${codigoLower}/articulos.json`);
    const estructuraModule = await import(`../../../data/${codigoLower}/estructura.json`);
    let referencias = {};
    try {
      const referenciasModule = await import(`../../../data/${codigoLower}/referencias.json`);
      referencias = referenciasModule.default || {};
    } catch (e) {
      // No referencias.json for this law, use empty object
    }
    let tooltips = {};
    try {
      const tooltipsModule = await import(`../../../data/${codigoLower}/tooltips.json`);
      tooltips = tooltipsModule.default || {};
    } catch (e) {
      // No tooltips.json for this law, use empty object
    }
    const articulos = articulosModule.default;
    const estructura = estructuraModule.default;

    // Pre-calculate breadcrumbs for all articles
    const breadcrumbs: (BreadcrumbItem[] | null)[] = articulos.map((art: any) =>
      estructura.divisiones
        ? findArticleBreadcrumb(estructura.divisiones, art.numero, codigoLower)
        : null
    );

    for (let i = 0; i < articulos.length; i++) {
      const articulo = articulos[i];
      const prevArt = i > 0 ? articulos[i - 1] : null;
      const nextArt = i < articulos.length - 1 ? articulos[i + 1] : null;
      const breadcrumb = breadcrumbs[i];

      // Calculate prev/next for each division level (titulo, capitulo, etc.)
      const breadcrumbWithNav: BreadcrumbItem[] = [];

      if (breadcrumb) {
        for (let level = 0; level < breadcrumb.length; level++) {
          const currentDivId = getDivisionId(breadcrumb, level);

          // Find first article of previous division at this level
          let prevDivArticulo: string | null = null;
          let prevDivId: string | null = null;
          // First, find where the previous division starts
          for (let j = i - 1; j >= 0; j--) {
            const otherDivId = getDivisionId(breadcrumbs[j], level);
            if (otherDivId && otherDivId !== currentDivId) {
              prevDivId = otherDivId;
              prevDivArticulo = articulos[j].numero;
              // Keep going back to find the FIRST article of that division
              for (let k = j - 1; k >= 0; k--) {
                const kDivId = getDivisionId(breadcrumbs[k], level);
                if (kDivId === prevDivId) {
                  prevDivArticulo = articulos[k].numero;
                } else {
                  break;
                }
              }
              break;
            }
          }

          // Find next article with different division at this level
          let nextDivArticulo: string | null = null;
          for (let j = i + 1; j < articulos.length; j++) {
            const otherDivId = getDivisionId(breadcrumbs[j], level);
            if (otherDivId && otherDivId !== currentDivId) {
              nextDivArticulo = articulos[j].numero;
              break;
            }
          }

          breadcrumbWithNav.push({
            ...breadcrumb[level],
            prevArticulo: prevDivArticulo,
            nextArticulo: nextDivArticulo
          });
        }
      }

      paths.push({
        params: { ley: codigoLower, numero: articulo.numero },
        props: {
          articulo,
          leyInfo: ley,
          referenciasArticulo: referencias[articulo.numero] || {},
          tooltipsArticulo: tooltips[articulo.numero] || {},
          prevArticulo: prevArt ? { numero: prevArt.numero } : null,
          nextArticulo: nextArt ? { numero: nextArt.numero } : null,
          totalArticulos: articulos.length,
          indiceActual: i + 1,
          breadcrumb: breadcrumbWithNav
        }
      });
    }
  }

  return paths;
}

interface Props {
  articulo: {
    numero: string;
    tipo: string;
    contenido: string;
    pagina: number;
    y: number;
    referencias?: string;
    parrafos: Array<{
      numero: number;
      tipo: string;
      identificador: string | null;
      contenido: string;
      padre_numero: number | null;
      referencias?: string[];
    }>;
  };
  leyInfo: typeof catalogo.leyes[0];
  referenciasArticulo: Record<string, { ley: string; articulo: string; parrafo: number }>;
  tooltipsArticulo: Record<string, string>;
  prevArticulo: { numero: string } | null;
  nextArticulo: { numero: string } | null;
  totalArticulos: number;
  indiceActual: number;
  breadcrumb: BreadcrumbItem[];
}

const { articulo, leyInfo, referenciasArticulo, tooltipsArticulo, prevArticulo, nextArticulo, totalArticulos, indiceActual, breadcrumb } = Astro.props;
const codigoLower = leyInfo.codigo.toLowerCase();
const isDerogado = articulo.tipo === 'derogado';
const tieneParrafos = articulo.parrafos && articulo.parrafos.length > 0;
const pdfUrl = `/pdfs/${codigoLower}.pdf`;

// Buscar epígrafe del SAT para este artículo
const epigrafeInfo = epigrafesSat.epigrafes.find(
  (e: any) => e.ley === leyInfo.codigo && e.articulo === articulo.numero
);

// Get last breadcrumb item for division indicator
const currentDivision = breadcrumb.length > 0 ? breadcrumb[breadcrumb.length - 1] : null;

// Format breadcrumb for search metadata
const seccionTexto = breadcrumb.length > 0
  ? breadcrumb.map(b => `${b.tipo.charAt(0).toUpperCase() + b.tipo.slice(1)} ${b.numero}${b.nombre ? ` - ${b.nombre}` : ''}`).join(' › ')
  : '';
---

<BaseLayout title={`Artículo ${articulo.numero} - ${leyInfo.codigo}`} article={true} hideFloatingToggle={true} description={`${leyInfo.nombre} - Artículo ${articulo.numero}. Texto completo y actualizado.`}>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LegalDocument",
    "name": `Artículo ${articulo.numero}`,
    "description": `${leyInfo.nombre} - Artículo ${articulo.numero}`,
    "isPartOf": {
      "@type": "Legislation",
      "name": leyInfo.nombre,
      "alternateName": leyInfo.codigo
    },
    "inLanguage": "es-MX",
    "jurisdiction": "MX"
  })} />
  <div class="h-screen flex flex-col overflow-hidden">
    <!-- Header fijo -->
    <header class="flex-shrink-0 z-20 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 px-4 py-2">
      <div class="flex items-center w-full">
        <!-- Izquierda: Logo -->
        <div class="flex-1 flex justify-start">
          <a href="/" class="flex items-center gap-1.5 text-primary-600 hover:text-primary-700 font-semibold whitespace-nowrap">
            <svg class="w-6 h-6" viewBox="0 0 32 32" fill="currentColor">
              <rect width="32" height="32" rx="6" fill="currentColor"/>
              <text x="16" y="22" text-anchor="middle" font-family="system-ui" font-size="14" font-weight="700" fill="white">LM</text>
            </svg>
            <span class="hidden sm:inline">LeyesMX</span>
          </a>
        </div>

        <!-- Centro: Acciones -->
        <div class="flex items-center gap-2 justify-center">
          <a
            href="/buscar/"
            class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-gray-600 dark:text-gray-400"
            title="Buscar"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </a>

          <button
            id="copy-btn"
            type="button"
            class="p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-gray-600 dark:text-gray-400"
            title="Copiar"
          >
            <svg id="copy-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <svg id="check-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </button>

          <ViewModeToggle />
        </div>

        <!-- Derecha: Theme -->
        <div class="flex-1 flex justify-end">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <!-- Contenido -->
    <main id="article-container" data-viewmode="text" class="article-container flex-1">
      <!-- Panel de texto -->
      <div id="text-panel" class="text-panel">
        <!-- Header interno del panel (fijo) - dos columnas -->
        <header class="text-panel-header">
          <div class="header-two-col">
            {/* Columna izquierda: contexto jerárquico */}
            <div class="header-context">
              <a href={`/${codigoLower}/`} class="context-link context-ley">
                {leyInfo.nombre}
              </a>
              {breadcrumb.map((item) => (
                <BreadcrumbNav item={item} leyCode={codigoLower} />
              ))}
              {/* Nombre del artículo/regla */}
              {articulo.nombre && (
                <span class="context-nombre-articulo">
                  {articulo.nombre}
                </span>
              )}
              {/* Epígrafe del SAT (solo texto, URLs no verificadas) */}
              {epigrafeInfo && (
                <span class="context-epigrafe">
                  <span class="epigrafe-fuente">SAT:</span> {epigrafeInfo.epigrafe}
                </span>
              )}
            </div>

            {/* Columna derecha: navegador de artículos */}
            <ArticleNavigator
              articuloActual={articulo.numero}
              prevArticulo={prevArticulo}
              nextArticulo={nextArticulo}
              leyCode={codigoLower}
            />
          </div>
        </header>

        <!-- Contenedor principal: contenido + sidebar -->
        <div class="text-panel-body">
          {/* Área de contenido scrolleable */}
          <div class="text-panel-content">
            <article id="article-content" data-pagefind-body>
              {/* Metadata oculta para búsqueda */}
              <p class="hidden" data-pagefind-meta="ley" data-pagefind-filter="ley">{leyInfo.codigo}</p>
              <p class="hidden" data-pagefind-filter="tipo">{leyInfo.tipo}</p>
              <p class="hidden" data-pagefind-meta="categoria" data-pagefind-filter="categoria">{leyInfo.categoria}</p>
              {seccionTexto && <p class="hidden" data-pagefind-meta="seccion">{seccionTexto}</p>}

              {/* Referencias cruzadas (solo RMF) */}
              {articulo.referencias && (
                <ReferenciasList referencias={articulo.referencias} />
              )}

              <div id="legal-content">
                {isDerogado ? (
                  <div class="p-4 bg-gray-100 dark:bg-gray-800 rounded-lg text-gray-500 dark:text-gray-400 italic">
                    Artículo derogado
                  </div>
                ) : tieneParrafos ? (
                  <FraccionesView parrafos={articulo.parrafos} referencias={referenciasArticulo} tooltips={tooltipsArticulo} />
                ) : (
                  <div class="prose-legal">
                    <p class="text-gray-800 dark:text-gray-200 whitespace-pre-wrap">
                      {articulo.contenido}
                    </p>
                  </div>
                )}
              </div>
            </article>
          </div>

          {/* Sidebar con TOC vertical a la derecha (solo si hay fracciones) */}
          {tieneParrafos && !isDerogado && (
            <aside class="text-panel-sidebar">
              <ArticleTocVertical parrafos={articulo.parrafos} />
            </aside>
          )}
        </div>
      </div>

      <!-- Panel de PDF -->
      <div
        id="pdf-panel"
        class="pdf-panel bg-gray-100 dark:bg-gray-800"
        data-pdf-url={pdfUrl}
        data-pagina={articulo.pagina}
        data-y={articulo.y}
        data-parrafos={JSON.stringify((articulo.parrafos || []).map(p => ({
          numero: p.numero,
          pagina: p.pagina,
          y: p.y
        })))}
      >
        <PdfViewer
          pdfUrl={pdfUrl}
          pagina={articulo.pagina}
          y={articulo.y}
          class="h-full"
        />
      </div>
    </main>

    <style>
      /* Main container fills available space */
      .article-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0; /* Critical for nested flex scroll */
        overflow: hidden;
      }

      /* Text panel - column layout with fixed header */
      .text-panel {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        overflow: hidden;
      }

      /* Internal header - NEVER scrolls */
      .text-panel-header {
        flex-shrink: 0;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid rgb(229 231 235);
        background-color: rgb(249 250 251);
      }

      :global(.dark) .text-panel-header {
        border-bottom-color: rgb(55 65 81);
        background-color: rgb(17 24 39);
      }

      /* Two-column header layout */
      .header-two-col {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }

      /* Left column: hierarchical context */
      .header-context {
        display: flex;
        flex-direction: column;
        gap: 0.125rem;
        min-width: 0;
        flex: 1;
      }

      .context-link {
        font-size: 1.125rem;
        color: rgb(75 85 99);
        text-decoration: none;
        transition: color 0.15s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .context-link:hover {
        color: rgb(37 99 235);
      }

      :global(.dark) .context-link {
        color: rgb(156 163 175);
      }

      :global(.dark) .context-link:hover {
        color: rgb(96 165 250);
      }

      .context-ley {
        font-weight: 600;
        font-size: 1.375rem;
        color: rgb(55 65 81);
      }

      :global(.dark) .context-ley {
        color: rgb(209 213 219);
      }

      .context-nombre {
        font-weight: 400;
        opacity: 0.8;
      }

      /* Nombre del artículo/regla - destacado */
      .context-nombre-articulo {
        font-weight: 500;
        color: rgb(55 65 81);
        font-size: 1rem;
      }

      :global(.dark) .context-nombre-articulo {
        color: rgb(209 213 219);
      }

      /* Epígrafe del SAT - azul oscuro para mejor contraste */
      .context-epigrafe {
        font-style: italic;
        color: rgb(29 78 216);
      }

      :global(.dark) .context-epigrafe {
        color: rgb(96 165 250);
      }

      .epigrafe-fuente {
        font-weight: 500;
        font-style: normal;
        opacity: 0.7;
      }

      /* Body contains sidebar + content */
      .text-panel-body {
        display: flex;
        flex: 1;
        min-height: 0; /* Critical for nested flex scroll */
        overflow: hidden;
      }

      /* Sidebar - NEVER scrolls (TOC handles its own scroll) */
      .text-panel-sidebar {
        flex-shrink: 0;
        overflow: hidden;
        background-color: rgb(249 250 251);
        border-left: 1px solid rgb(229 231 235);
      }

      :global(.dark) .text-panel-sidebar {
        background-color: rgb(17 24 39);
        border-left-color: rgb(55 65 81);
      }

      /* Content - ONLY element that scrolls */
      .text-panel-content {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 1.5rem;
      }

      /* Default: text mode - hide PDF */
      .article-container[data-viewmode="text"] .pdf-panel {
        display: none;
      }

      .article-container[data-viewmode="text"] .text-panel {
        display: flex;
      }

      /* PDF mode - hide text, show PDF full height */
      .article-container[data-viewmode="pdf"] .text-panel {
        display: none;
      }

      .article-container[data-viewmode="pdf"] .pdf-panel {
        flex: 1;
        min-height: 0;
      }

      /* Split mode - only on large screens */
      .article-container[data-viewmode="split"] .text-panel {
        display: flex;
      }

      .article-container[data-viewmode="split"] .pdf-panel {
        display: none;
      }

      @media (min-width: 1024px) {
        .article-container[data-viewmode="split"] {
          flex-direction: row;
        }

        .article-container[data-viewmode="split"] .text-panel {
          width: 50%;
          flex: none;
        }

        .article-container[data-viewmode="split"] .pdf-panel {
          display: flex;
          width: 50%;
          flex: none;
        }
      }

      /* Mobile: hide sidebar */
      @media (max-width: 640px) {
        .text-panel-sidebar {
          display: none;
        }
      }
    </style>

    <!-- Footer fijo con navegación -->
    <footer class="flex-shrink-0 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="container mx-auto max-w-4xl flex items-center justify-between">
        {prevArticulo ? (
          <a
            href={`/${codigoLower}/articulo/${prevArticulo.numero}/`}
            class="btn-secondary"
          >
            ← Art. {prevArticulo.numero}
          </a>
        ) : (
          <span></span>
        )}

        <a href={`/${codigoLower}/`} class="text-sm text-gray-500 hover:text-primary-600">
          Ver índice
        </a>

        {nextArticulo ? (
          <a
            href={`/${codigoLower}/articulo/${nextArticulo.numero}/`}
            class="btn-secondary"
          >
            Art. {nextArticulo.numero} →
          </a>
        ) : (
          <span></span>
        )}
      </div>
    </footer>
  </div>

  <!-- Copy script -->
  <script define:vars={{ articuloNumero: articulo.numero, leyNombre: leyInfo.nombre, leyCodigo: leyInfo.codigo }}>
    const copyBtn = document.getElementById('copy-btn');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');
    const copyText = document.getElementById('copy-text');
    const legalContent = document.getElementById('legal-content');

    copyBtn?.addEventListener('click', async () => {
      if (!legalContent) return;

      const header = `Artículo ${articuloNumero} - ${leyNombre} (${leyCodigo})\n\n`;
      const text = header + legalContent.innerText;
      try {
        await navigator.clipboard.writeText(text);
        // Visual feedback: show checkmark and "Copiado"
        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (copyText) copyText.textContent = 'Copiado';
        copyBtn.classList.add('text-primary-600');

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (copyText) copyText.textContent = 'Copiar';
          copyBtn.classList.remove('text-primary-600');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  </script>

  <!-- View mode toggle script -->
  <script is:inline>
    function initViewMode() {
      const container = document.getElementById('article-container');
      const toggleBtns = document.querySelectorAll('.view-mode-btn');
      if (!container) return;

      // Get saved preference or default to 'text'
      let savedMode = localStorage.getItem('viewMode') || 'text';

      // If screen is small and saved mode is split, fallback to text
      const isLargeScreen = window.matchMedia('(min-width: 1024px)').matches;
      if (savedMode === 'split' && !isLargeScreen) {
        savedMode = 'text';
      }

      function setViewMode(mode) {
        // Update data attribute - CSS handles the rest
        container.dataset.viewmode = mode;

        // Update button states
        toggleBtns.forEach(btn => {
          const btnMode = btn.dataset.mode;
          if (btnMode === mode) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // Save preference
        localStorage.setItem('viewMode', mode);
      }

      // Initialize
      setViewMode(savedMode);

      // Add click handlers (use event delegation to avoid duplicate listeners)
      toggleBtns.forEach(btn => {
        btn.onclick = () => {
          const mode = btn.dataset.mode;
          if (mode) setViewMode(mode);
        };
      });
    }

    // Run on initial load
    initViewMode();
    // Run after View Transitions navigation
    document.addEventListener('astro:page-load', initViewMode);
  </script>

  <!-- PDF sync with hash navigation -->
  <script is:inline>
    const PAGE_HEIGHT = 792;
    let syncTimeout = null;
    let pdfSyncInitialized = false;

    function getPdfData() {
      const panel = document.getElementById('pdf-panel');
      if (!panel) return null;
      return {
        pdfUrl: panel.dataset.pdfUrl,
        articuloPagina: parseInt(panel.dataset.pagina, 10) || 1,
        articuloY: parseInt(panel.dataset.y, 10) || 0,
        parrafosData: JSON.parse(panel.dataset.parrafos || '[]')
      };
    }

    function syncPdfToParrafo(parrafoNum) {
      const data = getPdfData();
      if (!data) return;

      const iframe = document.querySelector('#pdf-panel iframe');
      if (!iframe) return;

      let pagina = data.articuloPagina;
      let y = data.articuloY;

      if (parrafoNum) {
        const parrafo = data.parrafosData.find(p => p.numero === parrafoNum);
        if (parrafo && parrafo.pagina) {
          pagina = parrafo.pagina;
          y = parrafo.y || 0;
        }
      }

      // Build PDF URL with position
      const yFromBottom = Math.max(0, PAGE_HEIGHT - y);
      const newPdfUrl = y > 0
        ? `${data.pdfUrl}#page=${pagina}&zoom=page-width,0,${yFromBottom}`
        : `${data.pdfUrl}#page=${pagina}&zoom=page-width`;

      // Debounce to avoid PDF.js errors from rapid changes
      if (syncTimeout) clearTimeout(syncTimeout);
      syncTimeout = setTimeout(() => {
        iframe.src = newPdfUrl;
      }, 100);
    }

    function syncPdfWithHash() {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#p-')) {
        const parrafoNum = parseInt(hash.substring(3), 10);
        syncPdfToParrafo(parrafoNum);
      } else {
        syncPdfToParrafo(null);
      }
    }

    function handleChipClick(e) {
      const link = e.target.closest('a[href^="#p-"]');
      if (link) {
        const hash = link.getAttribute('href');
        const parrafoNum = parseInt(hash.substring(3), 10);
        // Small delay to let the browser update the hash first
        setTimeout(() => syncPdfToParrafo(parrafoNum), 50);
      }
    }

    function initPdfSync() {
      // Only add listener once (persists across View Transitions)
      if (!pdfSyncInitialized) {
        document.addEventListener('click', handleChipClick);
        window.addEventListener('hashchange', syncPdfWithHash);
        pdfSyncInitialized = true;
      }
      // Initial sync based on current hash
      syncPdfWithHash();
    }

    // Run on load
    requestAnimationFrame(initPdfSync);
    // Run after View Transitions navigation
    document.addEventListener('astro:page-load', () => {
      requestAnimationFrame(initPdfSync);
    });
  </script>
</BaseLayout>
