---
/**
 * PdfViewer - Muestra un PDF sincronizado a una página y coordenada Y específica
 *
 * Usa el estándar de URL de PDF para navegación:
 * file.pdf#page=N&zoom=page-width,0,Y
 */

interface Props {
  pdfUrl: string;
  pagina: number;
  y: number;
  pageHeight?: number;
  class?: string;
}

const { pdfUrl, pagina, y, pageHeight = 792, class: className = '' } = Astro.props;

// Convertir Y desde TOP (como viene de la BD) a BOTTOM (formato PDF URL)
const yFromBottom = Math.max(0, pageHeight - y);

// Construir URL con parámetros de navegación
const pdfUrlWithPosition = y > 0
  ? `${pdfUrl}#page=${pagina}&zoom=page-width,0,${yFromBottom}`
  : `${pdfUrl}#page=${pagina}&zoom=page-width`;
---

<div class:list={["pdf-viewer-container", className]}>
  <iframe
    src={pdfUrlWithPosition}
    class="w-full h-full border-0"
    title="Documento PDF"
    loading="lazy"
  />
</div>

<style>
  .pdf-viewer-container {
    width: 100%;
    height: 100%;
    background-color: #525659;
  }

  .pdf-viewer-container iframe {
    width: 100%;
    height: 100%;
    min-height: 70vh;
  }
</style>
