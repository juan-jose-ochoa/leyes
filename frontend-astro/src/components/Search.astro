---
// Custom Search component with filters using MiniSearch
import catalogo from '../data/catalogo.json';

// Get unique law codes for filter chips
const leyes = catalogo.leyes.map(l => ({ codigo: l.codigo, nombre: l.nombre }));

// Document types
const tiposDocumento = [
  { value: 'ley', label: 'Leyes', color: 'bg-primary-600' },
  { value: 'codigo', label: 'Códigos', color: 'bg-primary-600' },
  { value: 'reglamento', label: 'Reglamentos', color: 'bg-blue-600' },
  { value: 'resolucion', label: 'RMF', color: 'bg-amber-600' },
];
---

<div class="w-full max-w-3xl mx-auto">
  <!-- Search form -->
  <form id="search-form" class="relative">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Buscar en leyes fiscales y laborales..."
        class="w-full rounded-xl border-2 border-gray-200 bg-white py-4 pl-12 pr-24 text-lg placeholder-gray-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-4 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500"
        autocomplete="off"
      />
      <div class="absolute right-3 top-1/2 flex -translate-y-1/2 items-center gap-2">
        <button
          id="clear-btn"
          type="button"
          class="hidden rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <button
          type="submit"
          class="btn-primary px-4 py-2"
        >
          Buscar
        </button>
      </div>
    </div>

    <!-- Filters toggle -->
    <div class="mt-2 flex items-center gap-2 text-sm text-gray-500">
      <button
        id="filters-toggle"
        type="button"
        class="flex items-center gap-1 rounded-lg px-2 py-1 hover:bg-gray-100 dark:hover:bg-gray-800"
      >
        Filtros
        <span id="filter-count" class="hidden ml-1 rounded-full bg-primary-100 px-2 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900 dark:text-primary-300">0</span>
      </button>
      <span class="text-gray-400">
        Presiona <kbd class="rounded bg-gray-100 px-1.5 py-0.5 font-mono text-xs dark:bg-gray-700">/</kbd> para buscar
      </span>
    </div>
  </form>

  <!-- Filters panel -->
  <div id="filters-panel" class="hidden mt-2 rounded-lg border border-gray-200 bg-white p-3 dark:border-gray-700 dark:bg-gray-800 space-y-3">
    <!-- Filter by document type -->
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-2">Tipo de documento</label>
      <div class="flex flex-wrap gap-2">
        {tiposDocumento.map((tipo) => (
          <button
            type="button"
            data-filter-tipo={tipo.value}
            data-color={tipo.color}
            class="filter-chip rounded-full px-3 py-1 text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600"
          >
            {tipo.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Filter by specific law -->
    <div>
      <label class="block text-xs font-medium text-gray-500 mb-2">Ley específica</label>
      <div class="flex flex-wrap gap-2">
        {leyes.map((ley) => (
          <button
            type="button"
            data-filter-ley={ley.codigo}
            title={ley.nombre}
            class="filter-chip rounded-full px-3 py-1 text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-300 dark:hover:bg-gray-600"
          >
            {ley.codigo}
          </button>
        ))}
      </div>
    </div>

    <!-- Clear filters -->
    <div id="clear-filters-wrap" class="hidden pt-2 border-t border-gray-200 dark:border-gray-700">
      <button
        id="clear-filters"
        type="button"
        class="text-sm text-gray-500 hover:text-gray-700 dark:hover:text-gray-300"
      >
        Limpiar todos los filtros
      </button>
    </div>
  </div>

  <!-- Results -->
  <div id="search-results" class="hidden mt-4">
    <p id="results-count" class="text-sm text-gray-500 mb-3"></p>
    <div id="results-list" class="space-y-2"></div>
  </div>
</div>

<script>
  import MiniSearch from 'minisearch';

  // Types
  interface SearchResult {
    id: number;
    ley: string;
    tipo: string;
    categoria: string;
    numero: string;
    titulo: string;
    url: string;
    score: number;
  }

  interface ExcerptData {
    id: number;
    contenido: string;
  }

  // State
  let miniSearch: MiniSearch | null = null;
  let excerptMap: Map<number, string> = new Map();
  let searchLoading: Promise<void> | null = null;
  let selectedTipos: string[] = [];
  let selectedLeyes: string[] = [];

  // Elements
  const form = document.getElementById('search-form') as HTMLFormElement;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-btn');
  const filtersToggle = document.getElementById('filters-toggle');
  const filtersPanel = document.getElementById('filters-panel');
  const filterCount = document.getElementById('filter-count');
  const clearFiltersWrap = document.getElementById('clear-filters-wrap');
  const clearFilters = document.getElementById('clear-filters');
  const resultsDiv = document.getElementById('search-results');
  const resultsCount = document.getElementById('results-count');
  const resultsList = document.getElementById('results-list');

  // Initialize MiniSearch
  async function initSearch(): Promise<void> {
    if (miniSearch) return;
    if (searchLoading) return searchLoading;

    searchLoading = (async () => {
      try {
        const [indexRes, excerptRes] = await Promise.all([
          fetch('/search-index.json'),
          fetch('/search-excerpts.json')
        ]);

        const indexData = await indexRes.json();
        const excerptData: ExcerptData[] = await excerptRes.json();

        miniSearch = MiniSearch.loadJSON(JSON.stringify(indexData), {
          fields: ['contenido', 'titulo', 'numero'],
          storeFields: ['ley', 'tipo', 'categoria', 'numero', 'titulo', 'seccion', 'url']
        });

        excerptMap = new Map(excerptData.map(e => [e.id, e.contenido]));
        console.log('[MiniSearch] Índice cargado:', miniSearch.documentCount, 'documentos');
      } catch (e) {
        console.error('[MiniSearch] Error cargando índice:', e);
        searchLoading = null;
      }
    })();

    return searchLoading;
  }

  // Generate excerpt
  function generateExcerpt(contenido: string, query: string, maxLength = 150): string {
    const terms = query.toLowerCase().split(/\s+/).filter(t => t.length > 2);
    const contenidoLower = contenido.toLowerCase();

    let bestPos = 0;
    let bestScore = 0;

    for (let i = 0; i < contenido.length - 50; i += 20) {
      const window = contenidoLower.substring(i, i + maxLength);
      const score = terms.filter(t => window.includes(t)).length;
      if (score > bestScore) {
        bestScore = score;
        bestPos = i;
      }
    }

    let start = Math.max(0, bestPos - 20);
    let excerpt = contenido.substring(start, start + maxLength);

    if (start > 0) excerpt = '...' + excerpt.replace(/^\S*\s/, '');
    if (start + maxLength < contenido.length) excerpt = excerpt.replace(/\s\S*$/, '') + '...';

    for (const term of terms) {
      const regex = new RegExp(`(${term}\\w*)`, 'gi');
      excerpt = excerpt.replace(regex, '<mark>$1</mark>');
    }

    return excerpt;
  }

  // Perform search
  async function doSearch(query: string) {
    if (!query.trim()) {
      resultsDiv?.classList.add('hidden');
      return;
    }

    await initSearch();
    if (!miniSearch) return;

    let results = miniSearch.search(query, {
      prefix: true,
      fuzzy: 0.2,
      boost: { titulo: 2, numero: 1.5 }
    }) as SearchResult[];

    // Apply filters
    if (selectedLeyes.length > 0) {
      results = results.filter(r => selectedLeyes.includes(r.ley));
    }
    if (selectedTipos.length > 0) {
      results = results.filter(r => selectedTipos.includes(r.tipo));
    }

    resultsDiv?.classList.remove('hidden');

    if (results.length === 0) {
      if (resultsCount) resultsCount.textContent = `No se encontraron resultados para "${query}"`;
      if (resultsList) resultsList.innerHTML = '';
      return;
    }

    if (resultsCount) {
      resultsCount.textContent = `${results.length} ${results.length === 1 ? 'resultado' : 'resultados'}`;
    }

    // Display first 20 results
    const displayed = results.slice(0, 20);

    if (resultsList) {
      resultsList.innerHTML = displayed.map((result) => {
        const contenido = excerptMap.get(result.id) || '';
        const excerpt = generateExcerpt(contenido, query);

        return `
        <a href="${result.url}" class="block p-3 rounded-lg border border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-xs font-medium px-2 py-0.5 rounded bg-primary-100 text-primary-700 dark:bg-primary-900 dark:text-primary-300">${result.ley}</span>
            <span class="font-semibold text-gray-900 dark:text-white">${result.titulo}</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">${excerpt}</p>
        </a>
      `;
      }).join('');
    }
  }

  // Update filter count badge
  function updateFilterCount() {
    const total = selectedTipos.length + selectedLeyes.length;
    if (filterCount) {
      filterCount.textContent = total.toString();
      filterCount.classList.toggle('hidden', total === 0);
    }
    clearFiltersWrap?.classList.toggle('hidden', total === 0);
  }

  // Update chip visual state
  function updateChipState(btn: HTMLElement, active: boolean) {
    if (active) {
      const color = btn.dataset.color || 'bg-primary-600';
      btn.classList.remove('bg-gray-100', 'text-gray-700', 'dark:bg-gray-700', 'dark:text-gray-300');
      btn.classList.add(color, 'text-white');
    } else {
      const color = btn.dataset.color || 'bg-primary-600';
      btn.classList.remove(color, 'text-white');
      btn.classList.add('bg-gray-100', 'text-gray-700', 'dark:bg-gray-700', 'dark:text-gray-300');
    }
  }

  // Event: Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    doSearch(input.value);
  });

  // Event: Input change
  input?.addEventListener('input', () => {
    clearBtn?.classList.toggle('hidden', !input.value);
  });

  // Event: Clear input
  clearBtn?.addEventListener('click', () => {
    input.value = '';
    clearBtn.classList.add('hidden');
    resultsDiv?.classList.add('hidden');
    input.focus();
  });

  // Event: Toggle filters
  filtersToggle?.addEventListener('click', () => {
    filtersPanel?.classList.toggle('hidden');
  });

  // Event: Filter chip clicks
  document.querySelectorAll('[data-filter-tipo]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tipo = (btn as HTMLElement).dataset.filterTipo!;
      const idx = selectedTipos.indexOf(tipo);
      if (idx >= 0) {
        selectedTipos.splice(idx, 1);
        updateChipState(btn as HTMLElement, false);
      } else {
        selectedTipos.push(tipo);
        updateChipState(btn as HTMLElement, true);
      }
      updateFilterCount();
      if (input.value) doSearch(input.value);
    });
  });

  document.querySelectorAll('[data-filter-ley]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const ley = (btn as HTMLElement).dataset.filterLey!;
      const idx = selectedLeyes.indexOf(ley);
      if (idx >= 0) {
        selectedLeyes.splice(idx, 1);
        updateChipState(btn as HTMLElement, false);
      } else {
        selectedLeyes.push(ley);
        updateChipState(btn as HTMLElement, true);
      }
      updateFilterCount();
      if (input.value) doSearch(input.value);
    });
  });

  // Event: Clear all filters
  clearFilters?.addEventListener('click', () => {
    selectedTipos = [];
    selectedLeyes = [];
    document.querySelectorAll('.filter-chip').forEach((btn) => {
      updateChipState(btn as HTMLElement, false);
    });
    updateFilterCount();
    if (input.value) doSearch(input.value);
  });

  // Event: Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      input?.focus();
    }
    if (e.key === 'Escape') {
      input?.blur();
      resultsDiv?.classList.add('hidden');
    }
  });
</script>
