---
/**
 * ViewModeToggle - Botones para cambiar entre modos de vista
 *
 * Modos:
 * - text: Solo texto del artículo
 * - split: Texto y PDF lado a lado
 * - pdf: Solo PDF
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={["view-mode-toggle inline-flex rounded-lg border border-gray-200 dark:border-gray-700 p-0.5 bg-gray-100 dark:bg-gray-800", className]}>
  <button
    type="button"
    data-mode="text"
    class="view-mode-btn px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
    title="Solo texto"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
    </svg>
  </button>

  <button
    type="button"
    data-mode="split"
    class="view-mode-btn px-3 py-1.5 text-sm font-medium rounded-md transition-colors hidden lg:flex"
    title="Texto y PDF"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
    </svg>
  </button>

  <button
    type="button"
    data-mode="pdf"
    class="view-mode-btn px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
    title="Solo PDF"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
    </svg>
  </button>
</div>

<style>
  .view-mode-btn {
    color: rgb(107 114 128); /* gray-500 */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .view-mode-btn:hover {
    color: rgb(55 65 81); /* gray-700 */
  }

  :global(.dark) .view-mode-btn {
    color: rgb(156 163 175); /* gray-400 */
  }

  :global(.dark) .view-mode-btn:hover {
    color: rgb(229 231 235); /* gray-200 */
  }

  .view-mode-btn.active {
    background-color: white;
    color: rgb(37 99 235); /* primary-600 */
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }

  :global(.dark) .view-mode-btn.active {
    background-color: rgb(31 41 55); /* gray-800 */
    color: rgb(96 165 250); /* primary-400 */
  }
</style>
