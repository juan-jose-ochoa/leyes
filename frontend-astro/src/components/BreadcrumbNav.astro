---
/**
 * BreadcrumbNav - Breadcrumb con chevrons de navegación
 * Permite navegar al título/capítulo anterior y siguiente
 */

interface BreadcrumbItem {
  tipo: string;
  numero: string;
  nombre: string | null;
  url: string;
  prevArticulo?: string | null;
  nextArticulo?: string | null;
}

interface Props {
  item: BreadcrumbItem;
  leyCode: string;
}

const { item, leyCode } = Astro.props;

const prevUrl = item.prevArticulo ? `/${leyCode}/articulo/${item.prevArticulo}/` : null;
const nextUrl = item.nextArticulo ? `/${leyCode}/articulo/${item.nextArticulo}/` : null;
const hasPrev = !!prevUrl;
const hasNext = !!nextUrl;
---

<div class="breadcrumb-nav">
  {/* Chevron izquierdo - división anterior */}
  {hasPrev ? (
    <a href={prevUrl} class="nav-chevron" title={`${item.tipo} anterior`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </a>
  ) : (
    <span class="nav-chevron disabled">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </span>
  )}

  {/* Contenido del breadcrumb */}
  <a href={item.url} class="breadcrumb-content">
    {/* Capítulo implícito (número 0): solo mostrar el nombre */}
    {item.tipo === 'capitulo' && item.numero === '0' ? (
      <span class="breadcrumb-nombre-solo">{item.nombre || 'Disposiciones Generales'}</span>
    ) : (
      <>
        <span class="breadcrumb-tipo">{item.tipo}</span> {item.numero}
        {item.nombre && <span class="breadcrumb-nombre"> — {item.nombre}</span>}
      </>
    )}
  </a>

  {/* Chevron derecho - división siguiente */}
  {hasNext ? (
    <a href={nextUrl} class="nav-chevron" title={`${item.tipo} siguiente`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  ) : (
    <span class="nav-chevron disabled">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </span>
  )}
</div>

<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0.125rem;
    border-radius: 0.25rem;
    color: rgb(156 163 175);
    transition: all 0.15s;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-chevron:not(.disabled):hover {
    color: rgb(59 130 246);
    background-color: rgb(239 246 255);
  }

  :global(.dark) .nav-chevron:not(.disabled):hover {
    color: rgb(96 165 250);
    background-color: rgb(30 58 138 / 0.3);
  }

  .nav-chevron.disabled {
    opacity: 0.2;
    cursor: default;
  }

  .nav-chevron svg {
    width: 100%;
    height: 100%;
  }

  .breadcrumb-content {
    font-size: 1.125rem;
    color: rgb(75 85 99);
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .breadcrumb-content:hover {
    color: rgb(37 99 235);
  }

  :global(.dark) .breadcrumb-content {
    color: rgb(156 163 175);
  }

  :global(.dark) .breadcrumb-content:hover {
    color: rgb(96 165 250);
  }

  .breadcrumb-tipo {
    text-transform: capitalize;
  }

  .breadcrumb-nombre {
    font-weight: 400;
    opacity: 0.8;
  }

  /* Capítulo implícito - solo nombre, sin "Capítulo 0" */
  .breadcrumb-nombre-solo {
    font-weight: 500;
  }
</style>
