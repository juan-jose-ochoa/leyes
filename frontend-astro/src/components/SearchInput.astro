---
/**
 * SearchInput - Componente de búsqueda con typeahead
 * Reutilizable en homepage y página de búsqueda
 */
interface Props {
  id?: string;
  placeholder?: string;
  autofocus?: boolean;
  showSubmitButton?: boolean;
  onSubmit?: 'redirect' | 'event';  // redirect: va a /buscar, event: dispara evento
}

const {
  id = 'search-input',
  placeholder = 'Buscar en leyes fiscales y laborales...',
  autofocus = false,
  showSubmitButton = true,
  onSubmit = 'redirect'
} = Astro.props;

const formId = `${id}-form`;
const dropdownId = `${id}-dropdown`;
---

<div class="search-input-wrapper relative w-full" data-search-wrapper data-on-submit={onSubmit}>
  <form id={formId} action="/buscar" method="get" class="relative">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id={id}
        type="text"
        name="q"
        placeholder={placeholder}
        class="search-input w-full rounded-xl border-2 border-gray-200 bg-white py-4 pl-12 pr-28 text-lg placeholder-gray-400 transition-colors focus:border-primary-500 focus:outline-none focus:ring-4 focus:ring-primary-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500"
        autocomplete="off"
        autofocus={autofocus}
      />
      <div class="absolute right-3 top-1/2 flex -translate-y-1/2 items-center gap-2">
        <button
          type="button"
          class="search-clear-btn hidden rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        {showSubmitButton && (
          <button type="submit" class="btn-primary px-4 py-2">
            Buscar
          </button>
        )}
      </div>

      <!-- Typeahead dropdown -->
      <div id={dropdownId} class="typeahead-dropdown hidden absolute left-0 right-0 top-full mt-1 rounded-xl border-2 border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-gray-800 z-30 overflow-hidden">
        <!-- Quick access section -->
        <div class="typeahead-quick hidden">
          <div class="flex items-center justify-between px-4 py-2 bg-gray-50 dark:bg-gray-900/50 border-b border-gray-100 dark:border-gray-700">
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              Acceso rápido
            </span>
            <span class="text-xs text-gray-400 dark:text-gray-500">↑↓ navegar · Enter ir</span>
          </div>
          <ul class="typeahead-results max-h-64 overflow-y-auto"></ul>
        </div>

        <!-- Ley matches section -->
        <div class="typeahead-leyes hidden">
          <div class="px-4 py-2 bg-gray-50 dark:bg-gray-900/50 border-b border-gray-100 dark:border-gray-700">
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Leyes</span>
          </div>
          <ul class="typeahead-ley-results max-h-48 overflow-y-auto"></ul>
        </div>

        <!-- Fulltext search hint -->
        <div class="typeahead-fulltext hidden border-t border-gray-100 dark:border-gray-700">
          <button type="button" class="typeahead-search-btn w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors text-left">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <span class="text-sm text-gray-600 dark:text-gray-300">
              Buscar "<span class="typeahead-query font-medium"></span>" en contenido
            </span>
            <span class="ml-auto text-xs text-gray-400">Enter</span>
          </button>
        </div>
      </div>
    </div>
  </form>
</div>

<script>
  import { executeTypeahead, type ArticuloMatch, type LeyMeta, type TypeaheadResult } from '../lib/typeahead';

  // Category colors for badges
  const categoryColors: Record<string, string> = {
    fiscal: 'bg-emerald-600',
    laboral: 'bg-blue-600',
    constitucional: 'bg-orange-600'
  };

  // State per wrapper
  interface SearchState {
    typeaheadResult: TypeaheadResult | null;
    selectedIndex: number;
    debounceTimer: ReturnType<typeof setTimeout> | null;
  }

  const stateMap = new WeakMap<HTMLElement, SearchState>();

  function getState(wrapper: HTMLElement): SearchState {
    if (!stateMap.has(wrapper)) {
      stateMap.set(wrapper, {
        typeaheadResult: null,
        selectedIndex: -1,
        debounceTimer: null
      });
    }
    return stateMap.get(wrapper)!;
  }

  function getElements(wrapper: HTMLElement) {
    return {
      form: wrapper.querySelector('form') as HTMLFormElement,
      input: wrapper.querySelector('.search-input') as HTMLInputElement,
      clearBtn: wrapper.querySelector('.search-clear-btn') as HTMLElement,
      dropdown: wrapper.querySelector('.typeahead-dropdown') as HTMLElement,
      quickSection: wrapper.querySelector('.typeahead-quick') as HTMLElement,
      resultsUl: wrapper.querySelector('.typeahead-results') as HTMLElement,
      leyesSection: wrapper.querySelector('.typeahead-leyes') as HTMLElement,
      leyResultsUl: wrapper.querySelector('.typeahead-ley-results') as HTMLElement,
      fulltextSection: wrapper.querySelector('.typeahead-fulltext') as HTMLElement,
      querySpan: wrapper.querySelector('.typeahead-query') as HTMLElement,
      searchBtn: wrapper.querySelector('.typeahead-search-btn') as HTMLElement
    };
  }

  function showDropdown(wrapper: HTMLElement) {
    const { dropdown } = getElements(wrapper);
    dropdown?.classList.remove('hidden');
  }

  function hideDropdown(wrapper: HTMLElement) {
    const { dropdown } = getElements(wrapper);
    dropdown?.classList.add('hidden');
    const state = getState(wrapper);
    state.typeaheadResult = null;
    state.selectedIndex = -1;
  }

  function renderResults(wrapper: HTMLElement, result: TypeaheadResult, query: string) {
    const els = getElements(wrapper);
    const state = getState(wrapper);

    state.typeaheadResult = result;
    state.selectedIndex = result.matches.length > 0 ? 0 : -1;

    // Update query text
    if (els.querySpan) {
      els.querySpan.textContent = query;
    }

    const hasQuickMatches = result.matches.length > 0;
    const hasLeyMatches = result.leyMatches && result.leyMatches.length > 0;

    els.quickSection?.classList.toggle('hidden', !hasQuickMatches);
    els.leyesSection?.classList.toggle('hidden', !hasLeyMatches);
    els.fulltextSection?.classList.toggle('hidden', query.length < 2);

    // Render article matches
    if (hasQuickMatches && result.parsed.leyMeta) {
      const leyMeta = result.parsed.leyMeta;
      const catColor = categoryColors[leyMeta.categoria] || 'bg-primary-600';

      const tipoLabel = leyMeta.tipo_contenido === 'regla' ? 'Regla' : 'Art.';
      els.resultsUl.innerHTML = result.matches.map((match, idx) => `
        <li>
          <a href="${match.url}/"
             data-typeahead-idx="${idx}"
             class="flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors ${idx === state.selectedIndex ? 'bg-primary-50 dark:bg-primary-900/20' : ''}">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-xs font-bold text-white ${catColor}">
              ${leyMeta.codigo.substring(0, 3)}
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class="font-medium text-gray-900 dark:text-white">${leyMeta.codigo} ${tipoLabel} ${match.n}</span>
                ${match.matchType === 'exact' ? '<span class="text-xs text-primary-600 dark:text-primary-400 font-medium">exacto</span>' : ''}
              </div>
              ${match.m ? `<p class="text-sm text-primary-600 dark:text-primary-400">${match.m}</p>` : ''}
              ${match.e ? `<p class="text-sm text-primary-600/80 dark:text-primary-400/80">${match.e}</p>` : ''}
              ${match.t ? `<p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-1">${match.t}</p>` : ''}
            </div>
            <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </li>
      `).join('');
    }

    // Render ley matches
    if (hasLeyMatches && result.leyMatches) {
      els.leyResultsUl.innerHTML = result.leyMatches.map((ley) => {
        const catColor = categoryColors[ley.categoria] || 'bg-primary-600';
        return `
          <li>
            <button type="button"
                    data-typeahead-ley="${ley.codigo}"
                    class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors text-left">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-xs font-bold text-white ${catColor}">
                ${ley.codigo.substring(0, 3)}
              </span>
              <div class="flex-1 min-w-0">
                <span class="font-medium text-gray-900 dark:text-white">${ley.codigo}</span>
                <p class="text-sm text-gray-500 dark:text-gray-400 truncate">${ley.nombre_corto}</p>
              </div>
              <span class="text-xs text-gray-400">${ley.total} arts.</span>
            </button>
          </li>
        `;
      }).join('');
    }

    showDropdown(wrapper);
  }

  function updateSelection(wrapper: HTMLElement, newIndex: number) {
    const state = getState(wrapper);
    const els = getElements(wrapper);

    if (!state.typeaheadResult || state.typeaheadResult.matches.length === 0) return;

    const maxIndex = state.typeaheadResult.matches.length - 1;
    state.selectedIndex = newIndex < 0 ? maxIndex : (newIndex > maxIndex ? 0 : newIndex);

    els.resultsUl.querySelectorAll('[data-typeahead-idx]').forEach((el, idx) => {
      const isSelected = idx === state.selectedIndex;
      el.classList.toggle('bg-primary-50', isSelected);
      el.classList.toggle('dark:bg-primary-900/20', isSelected);
    });

    const selectedEl = els.resultsUl.querySelector(`[data-typeahead-idx="${state.selectedIndex}"]`);
    selectedEl?.scrollIntoView({ block: 'nearest' });
  }

  function navigateToSelected(wrapper: HTMLElement): boolean {
    const state = getState(wrapper);
    if (!state.typeaheadResult || state.selectedIndex < 0) return false;
    const match = state.typeaheadResult.matches[state.selectedIndex];
    if (match) {
      window.location.href = match.url + '/';
      return true;
    }
    return false;
  }

  async function handleInput(wrapper: HTMLElement, query: string) {
    const state = getState(wrapper);
    const els = getElements(wrapper);

    if (state.debounceTimer) {
      clearTimeout(state.debounceTimer);
    }

    if (!query.trim()) {
      hideDropdown(wrapper);
      return;
    }

    state.debounceTimer = setTimeout(async () => {
      try {
        const result = await executeTypeahead(query);

        if (result.matches.length > 0 || result.leyMatches?.length || result.parsed.type !== 'search') {
          renderResults(wrapper, result, query);
        } else if (query.length >= 2) {
          // Show only fulltext option
          els.quickSection?.classList.add('hidden');
          els.leyesSection?.classList.add('hidden');
          els.fulltextSection?.classList.remove('hidden');
          if (els.querySpan) els.querySpan.textContent = query;
          showDropdown(wrapper);
          state.typeaheadResult = result;
          state.selectedIndex = -1;
        } else {
          hideDropdown(wrapper);
        }
      } catch (e) {
        console.error('[Typeahead] Error:', e);
        hideDropdown(wrapper);
      }
    }, 80);
  }

  function handleSubmit(wrapper: HTMLElement, e: Event) {
    const onSubmit = wrapper.dataset.onSubmit;
    const els = getElements(wrapper);
    const state = getState(wrapper);

    // If there's a selected typeahead item, navigate to it
    if (state.selectedIndex >= 0 && state.typeaheadResult?.matches.length) {
      e.preventDefault();
      navigateToSelected(wrapper);
      return;
    }

    hideDropdown(wrapper);

    if (onSubmit === 'event') {
      e.preventDefault();
      // Dispatch custom event for parent to handle
      wrapper.dispatchEvent(new CustomEvent('search-submit', {
        bubbles: true,
        detail: { query: els.input?.value || '' }
      }));
    }
    // If 'redirect', let the form submit naturally to /buscar
  }

  // Initialize all search wrappers
  function initSearchInputs() {
    document.querySelectorAll('[data-search-wrapper]').forEach((wrapper) => {
      const w = wrapper as HTMLElement;
      const els = getElements(w);

      // Input events
      els.input?.addEventListener('input', () => {
        els.clearBtn?.classList.toggle('hidden', !els.input?.value);
        handleInput(w, els.input?.value || '');
      });

      // Form submit
      els.form?.addEventListener('submit', (e) => handleSubmit(w, e));

      // Clear button
      els.clearBtn?.addEventListener('click', () => {
        if (els.input) {
          els.input.value = '';
          els.clearBtn?.classList.add('hidden');
          hideDropdown(w);
          els.input.focus();
        }
      });

      // Keyboard navigation
      els.input?.addEventListener('keydown', (e) => {
        const state = getState(w);
        const isOpen = !els.dropdown?.classList.contains('hidden');

        if (!isOpen) return;

        if (e.key === 'ArrowDown') {
          e.preventDefault();
          updateSelection(w, state.selectedIndex + 1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          updateSelection(w, state.selectedIndex - 1);
        } else if (e.key === 'Escape') {
          e.preventDefault();
          hideDropdown(w);
        } else if (e.key === 'Enter' && state.selectedIndex >= 0) {
          e.preventDefault();
          navigateToSelected(w);
        }
      });

      // Click on ley button (autocomplete)
      w.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const leyBtn = target.closest('[data-typeahead-ley]') as HTMLElement;
        if (leyBtn && els.input) {
          const leyCodigo = leyBtn.dataset.typeaheadLey;
          if (leyCodigo) {
            els.input.value = leyCodigo + ' ';
            els.input.focus();
            handleInput(w, els.input.value);
          }
        }

        // Click on search button
        if (target.closest('.typeahead-search-btn')) {
          hideDropdown(w);
          els.form?.submit();
        }
      });

      // Click outside to close
      document.addEventListener('click', (e) => {
        if (!w.contains(e.target as Node)) {
          hideDropdown(w);
        }
      });
    });
  }

  // Global "/" shortcut
  document.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') {
      e.preventDefault();
      const firstInput = document.querySelector('[data-search-wrapper] .search-input') as HTMLInputElement;
      firstInput?.focus();
    }
  });

  // Initialize on load and View Transitions
  document.addEventListener('astro:page-load', initSearchInputs);
  initSearchInputs();
</script>
