---
/**
 * ArticleNavigator - Navegación vertical entre artículos con chevrons
 * Muestra el número de artículo actual con navegación arriba/abajo
 */

interface Props {
  articuloActual: string;
  prevArticulo: { numero: string } | null;
  nextArticulo: { numero: string } | null;
  leyCode: string;
}

const { articuloActual, prevArticulo, nextArticulo, leyCode } = Astro.props;

const prevUrl = prevArticulo ? `/${leyCode}/articulo/${prevArticulo.numero}/` : null;
const nextUrl = nextArticulo ? `/${leyCode}/articulo/${nextArticulo.numero}/` : null;
---

<nav class="article-navigator">
  {/* Chevron superior - artículo anterior */}
  {prevUrl ? (
    <a href={prevUrl} class="nav-chevron" title={`Artículo ${prevArticulo!.numero}`}>
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
      <span class="nav-hint">{prevArticulo!.numero}</span>
    </a>
  ) : (
    <div class="nav-chevron disabled">
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </div>
  )}

  {/* Número de artículo actual */}
  <div class="article-current">
    <span class="article-label">Artículo</span>
    <span class="article-number" data-pagefind-meta="title">{articuloActual}</span>
  </div>

  {/* Chevron inferior - artículo siguiente */}
  {nextUrl ? (
    <a href={nextUrl} class="nav-chevron" title={`Artículo ${nextArticulo!.numero}`}>
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
      <span class="nav-hint">{nextArticulo!.numero}</span>
    </a>
  ) : (
    <div class="nav-chevron disabled">
      <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  )}
</nav>

<style>
  .article-navigator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  /* Chevron button/link */
  .nav-chevron {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0.25rem;
    border-radius: 0.375rem;
    color: rgb(156 163 175);
    transition: all 0.15s;
    text-decoration: none;
  }

  .nav-chevron:not(.disabled):hover {
    color: rgb(59 130 246);
    background-color: rgb(239 246 255);
  }

  :global(.dark) .nav-chevron:not(.disabled):hover {
    color: rgb(96 165 250);
    background-color: rgb(30 58 138 / 0.3);
  }

  .nav-chevron.disabled {
    opacity: 0.2;
    cursor: default;
  }

  .chevron-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Hint number - aparece en hover */
  .nav-hint {
    position: absolute;
    right: 100%;
    margin-right: 0.5rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(59 130 246);
    background-color: rgb(239 246 255);
    border-radius: 0.25rem;
    opacity: 0;
    transform: translateX(0.5rem);
    transition: all 0.15s;
    pointer-events: none;
    white-space: nowrap;
  }

  :global(.dark) .nav-hint {
    color: rgb(96 165 250);
    background-color: rgb(30 58 138 / 0.5);
  }

  .nav-chevron:hover .nav-hint {
    opacity: 1;
    transform: translateX(0);
  }

  /* Artículo actual */
  .article-current {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .article-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(107 114 128);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.dark) .article-label {
    color: rgb(156 163 175);
  }

  .article-number {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: rgb(59 130 246);
  }

  :global(.dark) .article-number {
    color: rgb(96 165 250);
  }
</style>
