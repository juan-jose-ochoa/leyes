---
/**
 * ArticleTocVertical - TOC vertical fijo para navegación de fracciones
 * Se muestra como sidebar en el panel de texto
 */

interface Parrafo {
  numero: number;
  tipo: string;
  identificador: string | null;
  contenido: string;
  padre_numero: number | null;
}

interface Props {
  parrafos: Parrafo[];
}

const { parrafos } = Astro.props;

// Filtrar fracciones e incisos con identificador, en orden de aparición
const items = parrafos.filter(p =>
  (p.tipo === 'fraccion' || p.tipo === 'inciso') && p.identificador
);

// Generar ID de ancla (debe coincidir con FraccionesView.astro)
function getAnclaId(p: Parrafo): string {
  return `p-${p.numero}`;
}

// Mostrar TOC si hay 2+ items navegables
const mostrarToc = items.length >= 2;
---

{mostrarToc && (
  <nav class="toc-vertical">
    <div class="toc-scroll">
      <div class="toc-items">
        {items.map((item) => (
          <a
            href={`#${getAnclaId(item)}`}
            class={item.tipo === 'fraccion' ? 'toc-chip' : 'toc-inciso'}
            title={`${item.tipo === 'fraccion' ? 'Fracción' : 'Inciso'} ${item.identificador}`}
          >
            {item.identificador}{item.tipo === 'inciso' ? ')' : ''}
          </a>
        ))}
      </div>
    </div>
  </nav>
)}

<style>
  .toc-vertical {
    width: 3.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .toc-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.5rem 0.25rem;
  }

  .toc-items {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* Fracción chip - azul, más prominente */
  .toc-chip {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 0.375rem;
    background-color: rgb(219 234 254);
    color: rgb(30 64 175);
    transition: all 0.15s;
    white-space: nowrap;
  }

  :global(.dark) .toc-chip {
    background-color: rgb(30 58 138 / 0.5);
    color: rgb(147 197 253);
  }

  .toc-chip:hover {
    background-color: rgb(191 219 254);
    transform: scale(1.05);
  }

  :global(.dark) .toc-chip:hover {
    background-color: rgb(30 58 138 / 0.7);
  }

  /* Inciso chip - verde, más pequeño */
  .toc-inciso {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.375rem;
    font-size: 0.7rem;
    font-weight: 500;
    border-radius: 0.25rem;
    background-color: rgb(209 250 229);
    color: rgb(6 95 70);
    transition: all 0.15s;
    white-space: nowrap;
  }

  :global(.dark) .toc-inciso {
    background-color: rgb(6 78 59 / 0.5);
    color: rgb(167 243 208);
  }

  .toc-inciso:hover {
    background-color: rgb(167 243 208);
    transform: scale(1.05);
  }

  :global(.dark) .toc-inciso:hover {
    background-color: rgb(6 78 59 / 0.7);
  }

  /* Scrollbar styling */
  .toc-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .toc-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(209 213 219);
    border-radius: 2px;
  }

  :global(.dark) .toc-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(75 85 99);
  }
</style>
