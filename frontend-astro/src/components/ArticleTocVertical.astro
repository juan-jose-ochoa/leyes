---
/**
 * ArticleTocVertical - TOC vertical fijo para navegación de fracciones
 * Se muestra como sidebar en el panel de texto
 */

interface Parrafo {
  numero: number;
  tipo: string;
  identificador: string | null;
  contenido: string;
  padre_numero: number | null;
}

interface Props {
  parrafos: Parrafo[];
}

const { parrafos } = Astro.props;

// Filtrar elementos navegables con identificador, en orden de aparición
const items = parrafos.filter(p =>
  (p.tipo === 'apartado' || p.tipo === 'fraccion' || p.tipo === 'inciso' || p.tipo === 'numeral')
  && p.identificador
);

// Generar ID de ancla (debe coincidir con FraccionesView.astro)
function getAnclaId(p: Parrafo): string {
  return `p-${p.numero}`;
}

// Mostrar TOC si hay 2+ items navegables
const mostrarToc = items.length >= 2;

// Mapa de numero -> parrafo para buscar ancestros
const parrafosPorNumero = new Map<number, Parrafo>();
for (const p of parrafos) {
  parrafosPorNumero.set(p.numero, p);
}

// Construir ruta jerárquica completa para tooltip
function construirRutaTooltip(p: Parrafo): string {
  const nombres: Record<string, string> = {
    apartado: 'Apartado',
    fraccion: 'Fracción',
    inciso: 'Inciso',
    numeral: 'Numeral'
  };
  const ruta: string[] = [];
  let actual: Parrafo | undefined = p;

  while (actual) {
    if (actual.identificador) {
      const nombre = nombres[actual.tipo] || 'Párrafo';
      const sufijo = actual.tipo === 'inciso' ? ')' : '';
      ruta.unshift(`${nombre} ${actual.identificador}${sufijo}`);
    }
    actual = actual.padre_numero ? parrafosPorNumero.get(actual.padre_numero) : undefined;
  }

  return ruta.join(' → ');
}

// Mapeos para clases y sufijos por tipo
const clases: Record<string, string> = {
  apartado: 'toc-apartado',
  fraccion: 'toc-fraccion',
  inciso: 'toc-inciso',
  numeral: 'toc-numeral'
};
const sufijos: Record<string, string> = {
  apartado: '.',
  fraccion: '',
  inciso: ')',
  numeral: '.'
};
---

{mostrarToc && (
  <nav class="toc-vertical">
    <div class="toc-scroll">
      <div class="toc-items">
        {items.map((item) => (
          <a
            href={`#${getAnclaId(item)}`}
            class={clases[item.tipo] || 'toc-fraccion'}
            title={construirRutaTooltip(item)}
          >
            {item.identificador}{sufijos[item.tipo] || ''}
          </a>
        ))}
      </div>
    </div>
  </nav>
)}

<style>
  .toc-vertical {
    width: 3.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .toc-scroll {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.5rem 0.25rem;
  }

  .toc-items {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* Apartado - indigo, nivel superior (máxima jerarquía) */
  .toc-apartado {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    border-radius: 0.375rem;
    background-color: rgb(199 210 254); /* indigo-200 */
    color: rgb(55 48 163); /* indigo-800 */
    transition: all 0.15s;
    white-space: nowrap;
  }

  :global(.dark) .toc-apartado {
    background-color: rgb(49 46 129 / 0.5); /* indigo-900/50 */
    color: rgb(199 210 254); /* indigo-200 */
  }

  .toc-apartado:hover {
    background-color: rgb(165 180 252); /* indigo-300 */
    transform: scale(1.05);
  }

  :global(.dark) .toc-apartado:hover {
    background-color: rgb(49 46 129 / 0.7);
  }

  /* Fracción - blue, elemento principal */
  .toc-fraccion {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 0.375rem;
    background-color: rgb(191 219 254); /* blue-200 */
    color: rgb(30 64 175); /* blue-800 */
    transition: all 0.15s;
    white-space: nowrap;
  }

  :global(.dark) .toc-fraccion {
    background-color: rgb(30 58 138 / 0.5); /* blue-900/50 */
    color: rgb(191 219 254); /* blue-200 */
  }

  .toc-fraccion:hover {
    background-color: rgb(147 197 253); /* blue-300 */
    transform: scale(1.05);
  }

  :global(.dark) .toc-fraccion:hover {
    background-color: rgb(30 58 138 / 0.7);
  }

  /* Inciso - teal, sub-elemento */
  .toc-inciso {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.375rem;
    font-size: 0.7rem;
    font-weight: 500;
    border-radius: 0.25rem;
    background-color: rgb(153 246 228); /* teal-200 */
    color: rgb(17 94 89); /* teal-800 */
    transition: all 0.15s;
    white-space: nowrap;
  }

  :global(.dark) .toc-inciso {
    background-color: rgb(19 78 74 / 0.5); /* teal-900/50 */
    color: rgb(153 246 228); /* teal-200 */
  }

  .toc-inciso:hover {
    background-color: rgb(94 234 212); /* teal-300 */
    transform: scale(1.05);
  }

  :global(.dark) .toc-inciso:hover {
    background-color: rgb(19 78 74 / 0.7);
  }

  /* Numeral - slate, nivel de detalle */
  .toc-numeral {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.375rem;
    font-size: 0.7rem;
    font-weight: 500;
    border-radius: 0.25rem;
    background-color: rgb(226 232 240); /* slate-200 */
    color: rgb(30 41 59); /* slate-800 */
    transition: all 0.15s;
    white-space: nowrap;
  }

  :global(.dark) .toc-numeral {
    background-color: rgb(51 65 85); /* slate-700 sólido */
    color: rgb(226 232 240); /* slate-200 */
  }

  .toc-numeral:hover {
    background-color: rgb(203 213 225); /* slate-300 */
    transform: scale(1.05);
  }

  :global(.dark) .toc-numeral:hover {
    background-color: rgb(15 23 42 / 0.7);
  }

  /* Scrollbar styling */
  .toc-scroll::-webkit-scrollbar {
    width: 4px;
  }

  .toc-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(209 213 219);
    border-radius: 2px;
  }

  :global(.dark) .toc-scroll::-webkit-scrollbar-thumb {
    background-color: rgb(75 85 99);
  }
</style>
