---
/**
 * FraccionesView - Renderiza párrafos/fracciones/incisos con estilos jerárquicos
 *
 * Paleta por jerarquía (de mayor a menor):
 * - Apartado (A., B.): indigo - nivel superior
 * - Fracción (I., II.): blue - elemento principal
 * - Inciso (a), b)): teal - sub-elemento
 * - Numeral (1., 2.): slate - nivel de detalle
 * - Texto: gray - sin jerarquía
 */

interface Parrafo {
  numero: number;
  tipo: string;
  identificador: string | null;
  contenido: string;
  padre_numero: number | null;
  referencias?: string[];
  x_id?: number;
  x_texto?: number;
  y?: number;
  pagina?: number;
}

interface ReferenciaInfo {
  ley: string;
  articulo: string;
  parrafo: number;
  query?: string;  // DSL query para listas de artículos
}

interface Props {
  parrafos: Parrafo[];
  referencias?: Record<string, ReferenciaInfo>;
  tooltips?: Record<string, string>;
  mostrarReferencias?: boolean;
}

const { parrafos, referencias = {}, tooltips = {}, mostrarReferencias = true } = Astro.props;

// Calcular nivel de cada párrafo basado en padre_numero
function calcularNiveles(parrafos: Parrafo[]): Map<number, number> {
  const niveles = new Map<number, number>();

  for (const p of parrafos) {
    if (!p.padre_numero) {
      niveles.set(p.numero, 0);
    } else {
      const nivelPadre = niveles.get(p.padre_numero) ?? 0;
      niveles.set(p.numero, nivelPadre + 1);
    }
  }

  return niveles;
}

// Obtener sufijo según tipo
function getSufijo(tipo: string): string {
  switch (tipo) {
    case 'fraccion':
    case 'numeral':
    case 'apartado':
      return '.';
    case 'inciso':
      return ')';
    default:
      return '';
  }
}

// Obtener estilos según tipo (paleta jerárquica: indigo > blue > teal > slate > gray)
function getEstilos(tipo: string, nivel: number): { border: string; bg: string; margin: string; idColor: string } {
  const marginClasses = ['ml-0', 'ml-6', 'ml-12', 'ml-16'];
  const margin = marginClasses[Math.min(nivel, 3)];

  switch (tipo) {
    case 'apartado':
      return {
        border: 'border-l-4 border-indigo-500',
        bg: 'bg-indigo-50 dark:bg-indigo-900/20',
        margin,
        idColor: 'text-indigo-700 dark:text-indigo-300'
      };
    case 'fraccion':
      return {
        border: 'border-l-4 border-blue-500',
        bg: 'bg-blue-50 dark:bg-blue-900/20',
        margin,
        idColor: 'text-blue-700 dark:text-blue-300'
      };
    case 'inciso':
      return {
        border: 'border-l-[3px] border-teal-500',
        bg: 'bg-teal-50 dark:bg-teal-900/20',
        margin,
        idColor: 'text-teal-700 dark:text-teal-300'
      };
    case 'numeral':
      return {
        border: 'border-l-2 border-slate-400',
        bg: 'bg-slate-50 dark:bg-slate-800/20',
        margin,
        idColor: 'text-slate-700 dark:text-slate-300'
      };
    default:
      return {
        border: 'border-l-2 border-gray-200 dark:border-gray-700',
        bg: '',
        margin,
        idColor: 'text-gray-600 dark:text-gray-400'
      };
  }
}

// Generar ID de ancla para navegación (usa numero único del párrafo)
function getAnclaId(p: Parrafo): string {
  return `p-${p.numero}`;
}

// Limpiar contenido que empieza con sufijo duplicado
function limpiarContenido(contenido: string, tipo: string): string {
  const sufijos = [')', '.', '.-', '-'];
  for (const s of sufijos) {
    if (contenido.startsWith(s + ' ') || contenido.startsWith(s)) {
      return contenido.slice(s.length).trimStart();
    }
  }
  return contenido;
}

// Escapar HTML para evitar XSS
function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

// Procesar contenido insertando links de referencias y tooltips estructurales
function procesarContenido(
  texto: string,
  refs: Record<string, ReferenciaInfo>,
  tips: Record<string, string>
): string {
  // Escapar HTML primero
  let resultado = escapeHtml(texto);

  // Procesar referencias (links a artículos)
  if (refs && Object.keys(refs).length > 0) {
    // Ordenar keys por longitud descendente (evitar reemplazos parciales)
    const keys = Object.keys(refs).sort((a, b) => b.length - a.length);

    for (const textoRef of keys) {
      const ref = refs[textoRef];
      const textoEscapado = escapeHtml(textoRef);
      // Si tiene query DSL (lista de artículos), ir a búsqueda; sino, al artículo directo
      const url = ref.query
        ? `/buscar/?q=${encodeURIComponent(ref.query)}`
        : `/${ref.ley}/articulo/${ref.articulo}/#p-${ref.parrafo}`;
      const link = `<a href="${url}" class="ref-link">${textoEscapado}</a>`;
      resultado = resultado.replaceAll(textoEscapado, link);
    }
  }

  // Procesar tooltips estructurales (Título, Capítulo, Sección)
  if (tips && Object.keys(tips).length > 0) {
    // Ordenar por longitud descendente
    const keys = Object.keys(tips).sort((a, b) => b.length - a.length);

    for (const textoTip of keys) {
      const nombre = tips[textoTip];
      const textoEscapado = escapeHtml(textoTip);
      // Solo procesar si no está ya dentro de un tag (evitar doble procesamiento)
      if (!resultado.includes(`>${textoEscapado}<`)) {
        const span = `<span class="ref-estructura" data-tooltip="${escapeHtml(nombre)}">${textoEscapado}</span>`;
        resultado = resultado.replaceAll(textoEscapado, span);
      }
    }
  }

  return resultado;
}

const niveles = calcularNiveles(parrafos);
---

<div class="prose-legal space-y-3">
  {parrafos.map((p, idx) => {
    const nivel = niveles.get(p.numero) ?? 0;
    const estilos = getEstilos(p.tipo, nivel);
    const sufijo = getSufijo(p.tipo);
    const anclaId = getAnclaId(p);
    const parrafoLabel = p.identificador
      ? `${p.tipo.charAt(0).toUpperCase() + p.tipo.slice(1)} ${p.identificador}`
      : `Párrafo ${idx + 1}`;

    return (
      <div
        id={anclaId}
        class={`parrafo-container p-3 rounded-r-lg ${estilos.border} ${estilos.bg} ${estilos.margin} scroll-mt-20`}
      >
        {/* Heading oculto para Pagefind sub-results */}
        <h6 id={`${anclaId}-h`} class="sr-only">{parrafoLabel}</h6>
        <div class="parrafo-content">
          <div class="parrafo-texto">
            {p.identificador && (
              <span class={`font-semibold ${estilos.idColor} mr-2`}>
                {p.identificador}{sufijo}
              </span>
            )}
            <span
              class="text-gray-800 dark:text-gray-200"
              set:html={procesarContenido(limpiarContenido(p.contenido, p.tipo), referencias, tooltips)}
            />
          </div>
          {/* Chevron para sincronizar con PDF */}
          <a
            href={`#${anclaId}`}
            class="parrafo-sync"
            title="Ver en PDF"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>
        {mostrarReferencias && p.referencias && p.referencias.length > 0 && (
          <div class="text-right mt-1">
            {p.referencias.map((ref) => (
              <p class="text-xs italic text-blue-600 dark:text-blue-400">{ref}</p>
            ))}
          </div>
        )}
      </div>
    );
  })}
</div>

<style>
  .parrafo-container {
    position: relative;
  }

  .parrafo-content {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .parrafo-texto {
    flex: 1;
    min-width: 0;
  }

  .parrafo-sync {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0.25rem;
    border-radius: 0.25rem;
    color: rgb(156 163 175);
    opacity: 0;
    transition: all 0.15s;
  }

  .parrafo-container:hover .parrafo-sync {
    opacity: 1;
  }

  .parrafo-sync:hover {
    color: rgb(59 130 246);
    background-color: rgb(239 246 255);
  }

  :global(.dark) .parrafo-sync:hover {
    color: rgb(96 165 250);
    background-color: rgb(30 58 138 / 0.3);
  }

  .parrafo-sync svg {
    width: 100%;
    height: 100%;
  }

  /* Links de referencias a otros artículos */
  :global(.ref-link) {
    color: rgb(37 99 235);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
    transition: text-decoration-style 0.15s;
  }

  :global(.ref-link:hover) {
    text-decoration-style: solid;
  }

  :global(.dark .ref-link) {
    color: rgb(96 165 250);
  }

  /* Tooltips para referencias estructurales (Título, Capítulo, Sección) */
  :global(.ref-estructura) {
    border-bottom: 1px dotted rgb(107 114 128);
    cursor: help;
    position: relative;
  }

  :global(.ref-estructura:hover) {
    border-bottom-color: rgb(59 130 246);
  }

  :global(.ref-estructura::after) {
    content: attr(data-tooltip);
    position: absolute;
    bottom: 100%;
    left: 0;
    background: rgb(17 24 39);
    color: white;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    line-height: 1.25;
    white-space: normal;
    max-width: 280px;
    z-index: 50;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s, visibility 0.15s;
    pointer-events: none;
    margin-bottom: 0.25rem;
  }

  :global(.ref-estructura:hover::after) {
    opacity: 1;
    visibility: visible;
  }

  :global(.dark .ref-estructura) {
    border-bottom-color: rgb(156 163 175);
  }

  :global(.dark .ref-estructura:hover) {
    border-bottom-color: rgb(96 165 250);
  }

  :global(.dark .ref-estructura::after) {
    background: rgb(31 41 55);
  }
</style>
