---
/**
 * SearchSimple - Buscador del homepage con typeahead
 * Usa el componente SearchInput reutilizable
 */
import SearchInput from './SearchInput.astro';
---

<div class="max-w-2xl mx-auto">
  <SearchInput
    id="search-input-home"
    placeholder="Buscar en leyes fiscales y laborales..."
    showSubmitButton={true}
    onSubmit="redirect"
  />
</div>
