---
import { ViewTransitions } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  article?: boolean;
  hideFloatingToggle?: boolean;
}

const { title, description = 'Buscador de leyes fiscales y laborales mexicanas', article = false, hideFloatingToggle = false } = Astro.props;
const canonicalUrl = Astro.url.href;
const siteName = 'LeyesMX';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="LeyesMX" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={`${Astro.site}og-default.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site}og-default.png`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload font to avoid render blocking -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-var.woff2" crossorigin />

    <!-- Preconnect to Cloudflare Analytics -->
    <link rel="preconnect" href="https://cloudflareinsights.com" />

    <title>{title}</title>

    <!-- View Transitions for smooth navigation -->
    <ViewTransitions />
  </head>
  <body class="min-h-screen">
    <!-- Theme toggle fixed in corner (hidden when page has its own toggle) -->
    {!hideFloatingToggle && (
      <div class="fixed top-4 right-4 z-50">
        <ThemeToggle />
      </div>
    )}
    <slot />
    <script is:inline>
      // Dark mode initialization - runs on initial load and after View Transitions
      function initDarkMode() {
        if (localStorage.getItem('darkMode') === 'true' ||
            (!localStorage.getItem('darkMode') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
      initDarkMode();
      document.addEventListener('astro:after-swap', initDarkMode);
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
